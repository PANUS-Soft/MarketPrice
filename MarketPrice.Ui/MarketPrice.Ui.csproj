<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Focus ONLY on Android for now -->
		<TargetFrameworks>net9.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>MarketPrice.Ui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<RuntimeIdentifiers> android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>

		<!-- Keep one APK for all devices -->
		<AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

		<!-- App Info -->
		<ApplicationTitle>MarketPrice.Ui</ApplicationTitle>
		<ApplicationId>com.companyname.marketprice.ui</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Minimum Android version (Android 6) -->
		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>

	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screens -->
		<MauiSplashScreen Include="Resources\Images\marketprice.svg">
			<Color>#FFFFFF</Color>
			<BaseSize>128,128</BaseSize>
		</MauiSplashScreen>

		<MauiSplashScreen Include="Resources\Splash\marketprice.svg" Color="#FFFFFF" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<MauiImage Remove="Resources\Images\marketprice.svg" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="appsettings.json" />
		<EmbeddedResource Include="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.Core" Version="9.0.0" />

		<!-- ⚠️ KEEP these for now (but remember they may block 32-bit devices) -->
		<PackageReference Include="DevExpress.Maui.Charts" Version="25.1.7" />
		<PackageReference Include="DevExpress.Maui.CollectionView" Version="25.1.7" />
		<PackageReference Include="DevExpress.Maui.Controls" Version="25.1.7" />
		<PackageReference Include="DevExpress.Maui.Core" Version="25.1.7" />
		<PackageReference Include="DevExpress.Maui.DataGrid" Version="25.1.7" />
		<PackageReference Include="DevExpress.Maui.Editors" Version="25.1.7" />
		<PackageReference Include="DevExpress.Maui.Mvvm" Version="25.1.7" />
		<PackageReference Include="DevExpress.Maui.TreeView" Version="25.1.7" />

		<PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.8" />

		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.8" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MarketPrice.Domain\MarketPrice.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Views\Settings.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>