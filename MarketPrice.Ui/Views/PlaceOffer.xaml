<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:viewModel="clr-namespace:MarketPrice.Ui.ViewModels"
             x:Class="MarketPrice.Ui.Views.PlaceOffer"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F2F4F7"
             Title="PlaceOffer">

        <Grid RowDefinitions="Auto, Auto, *, Auto">

            <Border Grid.Row="0" Background="White" Padding="15,10" StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Opacity="0.05" Radius="5"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="45,*">
                    <ImageButton Source="back.png" HeightRequest="25" WidthRequest="25"
                                 MaximumHeightRequest="22" MaximumWidthRequest="22"
                                 Aspect="AspectFit" HorizontalOptions="Start" VerticalOptions="Center" IsVisible="{Binding IsCommodityDetailsStep}" Command="{Binding BackToMarketCommand}"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center" HorizontalOptions="Start" Background="Transparent">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer/>
                        </VerticalStackLayout.GestureRecognizers>

                        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                        <dxe:ComboBoxEdit
                            LabelText="Commodity Type"
                            ItemsSource="{Binding CommodityTypes}"
                            DisplayMember="Name"
                            SelectedItem="{Binding SelectedCommodityType}"
                            DropDownItemFontFamily="RobotoSerifRegular"
                            TextFontFamily="RobotoSerifRegular"
                            BoxMode="Outlined" 
                            CornerRadius="10"
                            FocusedBorderColor="{StaticResource PrimaryBase}"
                            PlaceholderText="Select commodity type"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding ShelfLifeInDaysDisplay}" FontSize="11" FontFamily="RobotoSerifBold" TextColor="#6C757D"/>
                            <Label Text="{Binding LotSizeDisplay}" FontSize="11" FontFamily="RobotoSerifBold" TextColor="#6C757D"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Row="1" Padding="20,15,20,5" Spacing="8">
                <Label Text="Place an Offer" HorizontalOptions="Center" FontSize="18" FontFamily="RobotoSerifBold" TextColor="{StaticResource PrimaryBase}"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" HeightRequest="4">
                    <BoxView Grid.Column="0" Color="{Binding Step1Color}" CornerRadius="2"/>
                    <BoxView Grid.Column="1" Color="{Binding Step2Color}" CornerRadius="2"/>
                    <BoxView Grid.Column="2" Color="{Binding Step3Color}" CornerRadius="2"/>
                </Grid>
                <Label Text="{Binding CurrentStepDisplay}" FontSize="14" HorizontalOptions="Center" FontFamily="RobotoSerifSemibold" TextColor="{StaticResource PrimaryBase}"/>
            </VerticalStackLayout>

            <ScrollView Grid.Row="2" Padding="20,0">
                <Grid>

                    <VerticalStackLayout Spacing="15" IsVisible="{Binding IsCommodityDetailsStep}">

                        <Border StrokeShape="RoundRectangle 12" Stroke="#E9ECEF" Padding="15" BackgroundColor="White">
                            <VerticalStackLayout Spacing="12">
                                <dxe:ComboBoxEdit 
                                    LabelText="Commodity"
                                    ItemsSource="{Binding Commodities}"
                                    DisplayMember="Name"
                                    SelectedItem="{Binding SelectedCommodity}"
                                    BoxMode="Outlined" 
                                    CornerRadius="10"
                                    TextFontFamily="RobotoSerifRegular"
                                    FocusedBorderColor="{StaticResource PrimaryBase}"/>
                                <Label Text="Grade" FontSize="13" FontFamily="RobotoSerifRegular" TextColor="{StaticResource TextPrimary}"/>
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10" HeightRequest="40">
                                    <Button Grid.Column="0" Text="A" BackgroundColor="White" TextColor="Black" BorderWidth="1" BorderColor="#DEE2E6" CornerRadius="8"/>
                                    <Button Grid.Column="1" Text="B" BackgroundColor="White" TextColor="Black" BorderWidth="1" BorderColor="#DEE2E6" CornerRadius="8"/>
                                    <Button Grid.Column="2" Text="C" BackgroundColor="White" TextColor="Black" BorderWidth="1" BorderColor="#DEE2E6" CornerRadius="8"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <dxe:TextEdit Grid.Column="0" LabelText="Quantity" TextFontFamily="RobotoSerifRegular" Keyboard="Numeric" BoxMode="Outlined" CornerRadius="10" Text="{Binding Quantity}" />
                                <dxe:TextEdit Grid.Column="1" LabelText="Total Quantity" TextFontFamily="RobotoSerifRegular" IsReadOnly="True" Text="{Binding TotalQuantityDisplay}" BoxMode="Outlined" CornerRadius="10" BackgroundColor="#F8F9FA"/>
                                </Grid>

                            <dxe:MultilineEdit LabelText="Description (Optional)" TextFontFamily="RobotoSerifRegular" HeightRequest="120" BoxMode="Outlined" CornerRadius="10"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="15" IsVisible="{Binding IsPricingAndTimingStep}">

                        <Border StrokeShape="RoundRectangle 12" Stroke="#E9ECEF" Padding="15" BackgroundColor="White">
                            <VerticalStackLayout Spacing="20">
                            <dxe:TextEdit LabelText="Unit Price" TextFontFamily="RobotoSerifRegular" Prefix="FCFA" Keyboard="Numeric" BoxMode="Outlined" CornerRadius="8"/>

                            <Label Text="Position Timeline" FontSize="13" FontFamily="RobotoSerifRegular" TextColor="#495057"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                    <dxe:DateEdit  Grid.Column="0" LabelText="Start Date" BoxMode="Outlined" CornerRadius="8" DisplayFormat="dd/MM/yyyy"/>
                                    <dxe:TimeEdit Grid.Column="1" LabelText="Start TIme" BoxMode="Outlined" CornerRadius="10"/>
                                </Grid> 
                            
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                    <dxe:DateEdit  Grid.Column="0" LabelText="End Date" BoxMode="Outlined" CornerRadius="8" DisplayFormat="G"/>
                                    <dxe:TimeEdit Grid.Column="1" LabelText="End TIme" BoxMode="Outlined" CornerRadius="10" />
                                </Grid>

                                <Label Text="{Binding OfferTotalValue}" FontFamily="RobotoSerifBold" HorizontalOptions="End" FontAttributes="Bold" FontSize="16" TextColor="#1A1C1E" Margin="0,10,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="15" IsVisible="{Binding IsLogisticsInformationStep}">
                        <Label Text="Original Location" FontAttributes="Bold" TextColor="#495057"/>
                        <Border StrokeShape="RoundRectangle 12" Stroke="#E9ECEF" Padding="15" BackgroundColor="White">
                            <VerticalStackLayout Spacing="10">
                                <dxe:ComboBoxEdit LabelText="Region" BoxMode="Outlined" CornerRadius="8"/>
                                <dxe:TextEdit LabelText="Town" BoxMode="Outlined" CornerRadius="8"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <dxe:TextEdit Grid.Column="0" LabelText="Quarter" BoxMode="Outlined" CornerRadius="8"/>
                                    <dxe:TextEdit Grid.Column="1" LabelText="Street" BoxMode="Outlined" CornerRadius="8"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Destination Location" FontAttributes="Bold" TextColor="#495057" Margin="0,10,0,0"/>
                        <Border StrokeShape="RoundRectangle 12" Stroke="#E9ECEF" Padding="15" BackgroundColor="White">
                            <VerticalStackLayout Spacing="10">
                                <dxe:ComboBoxEdit 
                                    LabelText="Region" 
                                    ItemsSource="{Binding Regions}"
                                    DisplayItemTemplate="{Binding NameInEnglish}"
                                    DisplayMember="NameInEnglish"
                                    BoxMode="Outlined" CornerRadius="8"/>
                                <dxe:TextEdit LabelText="Town" BoxMode="Outlined" CornerRadius="8"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <dxe:TextEdit Grid.Column="0" LabelText="Quarter" BoxMode="Outlined" CornerRadius="8" Text="{Binding LogisticsInfo.Quarter}"/>
                                    <dxe:TextEdit Grid.Column="1" LabelText="Street" BoxMode="Outlined" CornerRadius="8" Text="{Binding LogisticsInfo.Street}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Grid>

            </ScrollView>
          
            <Border Grid.Row="3" BackgroundColor="White" Padding="20,15" StrokeThickness="0">
                <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" IsVisible="{Binding IsBackTextVisible}"  Command="{Binding BackCommand}" FontFamily="RobotoSerifBold" Text="Back" BackgroundColor="Transparent" TextColor="#0056A0" FontAttributes="Bold" HorizontalOptions="Start"/>
                    <Button Grid.Column="1" Command="{Binding OfferContinueCommand}" Text="{Binding OfferButtonText}" FontFamily="RobotoSerifBold" BackgroundColor="#0056A0" TextColor="White" CornerRadius="5" HeightRequest="50" Padding="30,0" HorizontalOptions="End"/>
                </Grid>
            </Border>

    </Grid>


</ContentPage>