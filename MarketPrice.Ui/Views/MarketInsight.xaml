<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Charts;assembly=DevExpress.Maui.Charts"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             xmlns:dto="clr-namespace:MarketPrice.Domain.Market.DTOs;assembly=MarketPrice.Domain"
             x:DataType="viewModels:MarketInsightViewModel"
             x:Class="MarketPrice.Ui.Views.MarketInsight"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False"
             Title="MarketInsight">

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="0" Padding="0">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Padding="15,20,15,10" ColumnSpacing="15" BackgroundColor="Transparent">
            <ImageButton Grid.Column="0" 
                         Source="back.png" 
                         HeightRequest="24" 
                         WidthRequest="24" 
                         VerticalOptions="Center" 
                         Command="{Binding BackCommand}" 
                         BackgroundColor="Transparent"/>

            <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                <Border StrokeShape="RoundRectangle 30" 
                        HeightRequest="60" 
                        WidthRequest="60" 
                        HorizontalOptions="Center" 
                        Padding="0" 
                        StrokeThickness="0">
                    <Image Source="check.png" Aspect="AspectFill"/>
                </Border>

                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding CommodityName}" 
                           FontAttributes="Bold"
                           FontSize="18" 
                           TextColor="White"
                           FontFamily="RobotoSerifBold"/>

                    <Label Text="{Binding LotSizeDisplay}" 
                           FontSize="13" 
                           TextColor="White"
                           FontFamily="RobotoSerifRegular"/>

                    <Label Text="{Binding ShelfLifeDisplay}" 
                           FontSize="13" 
                           TextColor="White"
                           FontFamily="RobotoSerifRegular"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <ImageButton Grid.Column="2" Source="search_icon.png" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent" VerticalOptions="Center"/>
            <ImageButton Grid.Column="3" Source="favourite_icon.png" HeightRequest="24" WidthRequest="24" BackgroundColor="Transparent" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="20" Padding="15">

                <Border Grid.Row="0" 
                        Stroke="#334155" 
                        StrokeThickness="1" 
                        BackgroundColor="#1E293B" 
                        StrokeShape="RoundRectangle 12" 
                        Padding="15,10">
                    <Grid ColumnDefinitions="Auto, *, *, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="5">

                        <VerticalStackLayout Grid.Column="0" Grid.RowSpan="3" VerticalOptions="Center" Spacing="2">
                            <Label Text="Max(24h)" FontSize="10" TextColor="#94A3B8" FontFamily="RobotoSerifRegular"/>
                            <Label Text="{Binding MaxBid24H, StringFormat='CFA {0:N0}'}" FontSize="11" TextColor="White" FontFamily="RobotoSerifBold"/>
                            <Label Text="Min(24h)" FontSize="10" TextColor="#94A3B8" FontFamily="RobotoSerifRegular" Margin="0,8,0,0"/>
                            <Label Text="{Binding MinBid24H, StringFormat='CFA {0:N0}'}" FontSize="11" TextColor="White" FontFamily="RobotoSerifBold"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                            <Label Text="Bid" FontSize="14" TextColor="White" HorizontalOptions="Center" FontFamily="RobotoSerifMedium"/>
                            <Border Stroke="White" StrokeThickness="1" BackgroundColor="Transparent" Padding="15,4" StrokeShape="RoundRectangle 4">
                                <Label Text="{Binding BestBid, StringFormat='{0:N0}'}" FontSize="16" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Border>
                            <Label Text="{Binding BidCount}" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                            <Label Text="Offer" FontSize="14" TextColor="White" HorizontalOptions="Center" FontFamily="RobotoSerifMedium"/>
                            <Border Stroke="White" StrokeThickness="1" BackgroundColor="Transparent" Padding="15,4" StrokeShape="RoundRectangle 4">
                                <Label Text="{Binding BestOffer, StringFormat='{0:N0}'}" FontSize="16" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Border>
                            <Label Text="{Binding OfferCount}" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Grid.RowSpan="3" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                            <Label Text="Max(24h)" FontSize="10" TextColor="#94A3B8" HorizontalOptions="End" FontFamily="RobotoSerifRegular"/>
                            <Label Text="{Binding MaxOffer24H, StringFormat='CFA {0:N0}'}" FontSize="11" TextColor="White" HorizontalOptions="End" FontFamily="RobotoSerifBold"/>
                            <Label Text="Min(24h)" FontSize="10" TextColor="#94A3B8" HorizontalOptions="End" FontFamily="RobotoSerifRegular" Margin="0,8,0,0"/>
                            <Label Text="{Binding MinOffer24H, StringFormat='CFA {0:N0}'}" FontSize="11" TextColor="White" HorizontalOptions="End" FontFamily="RobotoSerifBold"/>
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <dxc:ChartView Grid.Row="1" HeightRequest="280" BackgroundColor="Transparent">
                    <dxc:ChartView.Hint>
                        <dxc:Hint ShowMode="OnTap">
                            <dxc:Hint.Style>
                                <dxc:HintStyle BackgroundColor="#1E293B"/>
                            </dxc:Hint.Style>
                        </dxc:Hint>
                    </dxc:ChartView.Hint>

                    <dxc:ChartView.Series>
                        <dxc:LineSeries MarkersVisible="True" DisplayName="Bid">
                            <dxc:LineSeries.Data>
                                <dxc:SeriesDataAdapter DataSource="{Binding PriceHistory}" ArgumentDataMember="Timestamp">
                                    <dxc:ValueDataMember Type="Value" Member="AvgBid"/>
                                </dxc:SeriesDataAdapter>
                            </dxc:LineSeries.Data>
                            <dxc:LineSeries.Style>
                                <dxc:LineSeriesStyle Stroke="#22C55E" StrokeThickness="2">
                                    <dxc:LineSeriesStyle.MarkerStyle>
                                        <dxc:MarkerStyle Fill="#22C55E"/>
                                    </dxc:LineSeriesStyle.MarkerStyle>
                                </dxc:LineSeriesStyle>
                            </dxc:LineSeries.Style>
                        </dxc:LineSeries>

                        <dxc:LineSeries MarkersVisible="True" DisplayName="Offer">
                            <dxc:LineSeries.Data>
                                <dxc:SeriesDataAdapter DataSource="{Binding PriceHistory}" ArgumentDataMember="Timestamp">
                                    <dxc:ValueDataMember Type="Value" Member="AvgOffer"/>
                                </dxc:SeriesDataAdapter>
                            </dxc:LineSeries.Data>
                            <dxc:LineSeries.Style>
                                <dxc:LineSeriesStyle Stroke="#3B82F6" StrokeThickness="2">
                                    <dxc:LineSeriesStyle.MarkerStyle>
                                        <dxc:MarkerStyle Fill="#3B82F6"/>
                                    </dxc:LineSeriesStyle.MarkerStyle>
                                </dxc:LineSeriesStyle>
                            </dxc:LineSeries.Style>
                        </dxc:LineSeries>
                    </dxc:ChartView.Series>

                    <dxc:ChartView.AxisX>
                        <dxc:DateTimeAxisX Visible="True">
                            <dxc:DateTimeAxisX.Label>
                                <dxc:AxisLabel TextFormat="dd MMM"/>
                            </dxc:DateTimeAxisX.Label>
                            <dxc:DateTimeAxisX.Style>
                                <dxc:AxisStyle LineColor="#334155" LineThickness="1"/>
                            </dxc:DateTimeAxisX.Style>
                        </dxc:DateTimeAxisX>
                    </dxc:ChartView.AxisX>

                    <dxc:ChartView.AxisY>
                        <dxc:NumericAxisY AlwaysShowZeroLevel="False">
                            <dxc:NumericAxisY.Label>
                                <dxc:AxisLabel TextFormat="N0"/>
                            </dxc:NumericAxisY.Label>
                            <dxc:NumericAxisY.Style>
                                <dxc:AxisStyle LineVisible="False" MajorGridlinesVisible="True" MajorGridlinesColor="#334155"/>
                            </dxc:NumericAxisY.Style>
                        </dxc:NumericAxisY>
                    </dxc:ChartView.AxisY>

                    <dxc:ChartView.Legend>
                        <dxc:Legend VerticalPosition="Top" HorizontalPosition="Center" Orientation="LeftToRight"/>
                    </dxc:ChartView.Legend>
                </dxc:ChartView>

                <VerticalStackLayout Grid.Row="2" Spacing="15" Margin="0,10,0,0">

                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,*">
                            <Label Grid.Column="0" Text="{Binding BidPercentage, StringFormat='{0:F0}%'}" FontSize="12" TextColor="#22C55E" FontFamily="RobotoSerifMedium"/>
                            <Label Grid.Column="1" Text="{Binding OfferPercentage, StringFormat='{0:F0}%'}" FontSize="12" TextColor="#3B82F6" HorizontalOptions="End" FontFamily="RobotoSerifMedium"/>
                        </Grid>

                        <Grid ColumnDefinitions="2*, 8*" HeightRequest="6">
                            <BoxView Grid.Column="0" Color="#22C55E" CornerRadius="3,0,0,3"/>
                            <BoxView Grid.Column="1" Color="#3B82F6" CornerRadius="0,3,3,0"/>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*,*,*" Padding="0,5">
                        <Label Grid.Column="0" Text="Bidders" FontSize="13" TextColor="White" FontFamily="RobotoSerifBold"/>
                        <Label Grid.Column="1" Text="Amount" FontSize="13" TextColor="White" FontFamily="RobotoSerifBold"/>
                        <Label Grid.Column="2" Text="Offerors" FontSize="13" TextColor="White" FontFamily="RobotoSerifBold" HorizontalOptions="Center"/>
                        <Label Grid.Column="3" Text="Amount" FontSize="13" TextColor="White" FontFamily="RobotoSerifBold" HorizontalOptions="End"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*">
                        <CollectionView Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding TopBids}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:MarketDepthItemDto">
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Grid.Column="0" Text="{Binding Quantity}" TextColor="#22C55E" FontSize="12" Margin="0,5"/>
                                        <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:N0}'}" TextColor="#22C55E" FontSize="12" Margin="0,5"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <CollectionView Grid.Column="2" Grid.ColumnSpan="2" ItemsSource="{Binding TopOffers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:MarketDepthItemDto">
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Grid.Column="0" Text="{Binding Quantity}" TextColor="#3B82F6" FontSize="12" HorizontalOptions="Center" Margin="0,5"/>
                                        <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:N0}'}" TextColor="#3B82F6" FontSize="12" HorizontalOptions="End" Margin="0,5"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" Padding="15" ColumnSpacing="10" BackgroundColor="{StaticResource Background}">
            <Button Grid.Column="0" FontFamily="RobotoSerifBold" Text="Place a Bid" BackgroundColor="{StaticResource PrimaryBase}" TextColor="White" CornerRadius="10" Command="{Binding NavigateToPlaceBidCommand}"/>
            <Button Grid.Column="1" FontFamily="RobotoSerifBold" Text="Place an Offer" BackgroundColor="White" BorderColor="{StaticResource PrimaryBase}" BorderWidth="3" TextColor="{StaticResource PrimaryBase}" CornerRadius="10" Command="{Binding NavigateToPlaceOfferCommand}"/>
        </Grid>
    </Grid>

</ContentPage>