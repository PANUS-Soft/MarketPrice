<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Charts;assembly=DevExpress.Maui.Charts"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             x:DataType="viewModels:MarketInsightViewModel"
             x:Class="MarketPrice.Ui.MarketInsight"
             Shell.TabBarIsVisible="False"
             Title="MarketInsight">

    
        
        <Grid RowDefinitions="Auto, *, Auto" RowSpacing="0" Padding="0">


            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto, Auto" Padding="15,10,15,10" BackgroundColor="white" VerticalOptions="Start" ColumnSpacing="10">
                <ImageButton Grid.Column="0" Source="back.png" MaximumHeightRequest="22" MaximumWidthRequest="22" VerticalOptions="Center" Command="{Binding BackCommand}" BackgroundColor="Transparent"/>

                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Label Text="{Binding SelectedMarketItem.Name}" FontSize="18" FontFamily="RobotoSerifMedium"/>
                    <Image Source="dropdown_icon.png" HeightRequest="10" VerticalOptions="Center" Margin="0,2,0,0"/>
                </HorizontalStackLayout>

           

            <ImageButton Grid.Column="3" Source="favourite_icon.png" MaximumHeightRequest="22" MaximumWidthRequest="22" BackgroundColor="Transparent" HorizontalOptions="Center"/>
                <ImageButton Grid.Column="4" Source="bell_icon.png" MaximumHeightRequest="22" MaximumWidthRequest="22" BackgroundColor="Transparent" HorizontalOptions="End"/>
            </Grid>

        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="20" Padding="15">
                <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="Bid" FontSize="14" FontFamily="RobotoSerifMedium"/>
                                <Label Text="{Binding SelectedMarketItem.BestBid}"  FontSize="18" FontFamily="RobotoSerifBold" TextColor="{StaticResource PrimaryBase}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="Max(24h)" FontSize="11" FontFamily="RobotoSerifRegular"/>
                                <Label Text="CFA 700" FontSize="11" FontFamily="RobotoSerifMedium"/>
                                <Label Text="Min(24h)" FontSize="11" FontFamily="RobotoSerifRegular" Margin="0,5,0,0"/>
                                <Label Text="CFA 500" FontSize="11" FontFamily="RobotoSerifMedium"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="Offer" FontSize="14" FontFamily="RobotoSerifMedium"/>
                                <Label Text="{Binding SelectedMarketItem.BestOffer}" FontSize="18" FontFamily="RobotoSerifBold" TextColor="{StaticResource PrimaryBase}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                <Label Text="Max(24h)" FontSize="11" FontFamily="RobotoSerifRegular"/>
                                <Label Text="CFA 650" FontSize="11" FontFamily="RobotoSerifMedium"/>
                                <Label Text="Min(24h)" FontSize="11" FontFamily="RobotoSerifRegular" Margin="0,5,0,0"/>
                                <Label Text="CFA 475" FontSize="11" FontFamily="RobotoSerifMedium"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <dxc:ChartView Grid.Row="1" HeightRequest="280">
                    <dxc:ChartView.Hint>
                        <dxc:Hint ShowMode="OnTap"/>
                    </dxc:ChartView.Hint>

                    <dxc:ChartView.Series>
                        <dxc:LineSeries MarkersVisible="True" DisplayName="Price Trend">
                            <dxc:LineSeries.Data>
                                <dxc:SeriesDataAdapter DataSource="{Binding PriceHistory}" ArgumentDataMember="Date">
                                    <dxc:ValueDataMember Type="Value" Member="Price"/>
                                </dxc:SeriesDataAdapter>
                            </dxc:LineSeries.Data>
                            <dxc:LineSeries.Style>
                                <dxc:LineSeriesStyle Stroke="#4A90E2" StrokeThickness="2"/>
                            </dxc:LineSeries.Style>
                        </dxc:LineSeries>
                    </dxc:ChartView.Series>

                    <dxc:ChartView.AxisX>
                        <dxc:DateTimeAxisX Visible="True">
                            <dxc:DateTimeAxisX.Label>
                                <dxc:AxisLabel TextFormat="yyyy-mm-dd"/>
                            </dxc:DateTimeAxisX.Label>
                        </dxc:DateTimeAxisX>
                    </dxc:ChartView.AxisX>

                    <dxc:ChartView.AxisY>
                        <dxc:NumericAxisY AlwaysShowZeroLevel="True">
                        </dxc:NumericAxisY>
                    </dxc:ChartView.AxisY>

                </dxc:ChartView>

                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <Label Text="Market Depth" FontSize="16" FontFamily="RobotoSerifMedium"/>

                    <Grid ColumnDefinitions="*,*" HeightRequest="25">
                        <Label Grid.Column="0" Text="50.00%" FontSize="12" TextColor="#22C55E" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="50.00%" FontSize="12" TextColor="#EF4444" HorizontalOptions="End" VerticalOptions="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="5*, 5*" HeightRequest="5">
                        <BoxView Grid.Column="0" HeightRequest="4" Color="#22C55E" CornerRadius="2,0,0,2"/>
                        <BoxView Grid.Column="1" HeightRequest="4" Color="#EF4444" CornerRadius="0,2,2,0"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                        <Label Grid.Column="0" Text="Bid" FontFamily="RobotoSerifRegular" FontSize="14"/>
                        <Label Grid.Column="1" Text="Offer" FontFamily="RobotoSerifRegular" FontSize="14" HorizontalOptions="End"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <CollectionView Grid.Column="0" ItemsSource="{Binding MarketDepthBids}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DepthItem">
                                    <Label Text="{Binding Value}" TextColor="#22C55E" HorizontalOptions="Start"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <CollectionView Grid.Column="1" ItemsSource="{Binding MarketDepthOffers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DepthItem">
                                    <Label Text="{Binding Value}" TextColor="#EF4444" HorizontalOptions="End"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </VerticalStackLayout>
            </Grid>
            
        </ScrollView>
        <!--<HorizontalStackLayout Grid.Row="2" Padding="15" BackgroundColor="White">
            <Button Grid.Column="0" Text="Place a Bid" BackgroundColor="{StaticResource PrimaryBase}" TextColor="White" CornerRadius="10" Command="{Binding NavigateToPlaceBidCommand}"/>
            <Button Grid.Column="1" Text="Place an Offer" BackgroundColor="White" BorderColor="{StaticResource PrimaryBase}" BorderWidth="3" TextColor="{StaticResource PrimaryBase}" CornerRadius="10" Command="{Binding NavigateToPlaceOfferCommand}"/>

        </HorizontalStackLayout>-->
        <Grid Grid.Row="4" ColumnDefinitions="*, *" Padding="15" ColumnSpacing="10" BackgroundColor="White">
            <Button Grid.Column="0" Text="Place a Bid" BackgroundColor="{StaticResource PrimaryBase}" TextColor="White" CornerRadius="10" Command="{Binding NavigateToPlaceBidCommand}"/>
            <Button Grid.Column="1" Text="Place an Offer" BackgroundColor="White" BorderColor="{StaticResource PrimaryBase}" BorderWidth="3" TextColor="{StaticResource PrimaryBase}" CornerRadius="10" Command="{Binding NavigateToPlaceOfferCommand}"/>
        </Grid>
        </Grid>
   
    
</ContentPage>