<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             xmlns:converters="clr-namespace:MarketPrice.Ui.Converters"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             x:Class="MarketPrice.Ui.Views.PositionListing"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <converters:NameToInitialsConverter x:Key="NameToInitialsConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Padding="15,15,15,0" BackgroundColor="#121212">

        <Grid Grid.Row="0" 
              ColumnDefinitions="40, *" 
              Margin="0,0,0,25" 
              VerticalOptions="Center">

            <ImageButton Grid.Column="0" 
                         Source="back.png" 
                         HeightRequest="24" 
                         WidthRequest="24"
                         HorizontalOptions="Start" 
                         VerticalOptions="Center"
                         Command="{Binding GoBackCommand}"/>

            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 8"
                    Stroke="White"
                    StrokeThickness="1"
                    BackgroundColor="Transparent"
                    HeightRequest="45">
                <SearchBar Placeholder="Search positions..."
                           Text="{Binding SearchText}"
                           BackgroundColor="Transparent"
                           TextColor="White"
                           PlaceholderColor="#888888"
                           CancelButtonColor="White"
                           VerticalOptions="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" 
              ColumnDefinitions="70, *, Auto, Auto" 
              ColumnSpacing="5" 
              Margin="0,0,0,30">

            <Border Grid.Column="0" 
                    HeightRequest="65" 
                    WidthRequest="65" 
                    StrokeShape="RoundRectangle 32" 
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Image Source="{Binding CommodityImage}" 
                       Aspect="AspectFill"/>
            </Border>

            <VerticalStackLayout Grid.Column="1" 
                                 VerticalOptions="Center" 
                                 Spacing="1">
                <Label Text="{Binding CommodityTypeName}" 
                       FontFamily="RobotoSerifBold" 
                       FontSize="12" 
                       TextColor="White"
                       LineBreakMode="NoWrap"
                       MaxLines="1"/>

                <Label Text="{Binding LotSize, StringFormat='Lot size: {0}'}" 
                       FontFamily="RobotoSerifRegular" 
                       FontSize="11" 
                       TextColor="#CCCCCC"
                       LineBreakMode="NoWrap"
                       MaxLines="1"/>

                <Label Text="{Binding ShelfLife, StringFormat='Shelf life: {0}'}" 
                       FontFamily="RobotoSerifRegular" 
                       FontSize="11" 
                       TextColor="#CCCCCC"
                       LineBreakMode="NoWrap"
                       MaxLines="1"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                <Label Text="Bid" FontFamily="RobotoSerifBold" FontSize="11" TextColor="White" HorizontalOptions="Center"/>

                <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                    <Label Text="&lt;" TextColor="White" FontSize="16" FontFamily="RobotoSerifBold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousPriceCommand}" CommandParameter="Bid"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Border Stroke="White" StrokeThickness="1" BackgroundColor="Transparent" StrokeShape="RoundRectangle 5" Padding="10,5">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPriceCommand}" CommandParameter="Bid"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsBidHighlighted}" Value="True">
                                <Setter Property="StrokeThickness" Value="2" />
                                <Setter Property="BackgroundColor" Value="#333333" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding BidPrice}" TextColor="White" FontSize="12" FontFamily="RobotoSerifRegular" HorizontalOptions="Center"/>
                    </Border>

                    <Label Text="&gt;" TextColor="White" FontSize="16" FontFamily="RobotoSerifBold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextPriceCommand}" CommandParameter="Bid"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Label Text="{Binding BidCount}" TextColor="#CCCCCC" FontSize="10" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                <Label Text="Offer" FontFamily="RobotoSerifBold" FontSize="11" TextColor="White" HorizontalOptions="Center"/>

                <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                    <Label Text="&lt;" TextColor="White" FontSize="16" FontFamily="RobotoSerifBold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PreviousPriceCommand}" CommandParameter="Offer"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Border Stroke="White" StrokeThickness="1" BackgroundColor="Transparent" StrokeShape="RoundRectangle 5" Padding="10,5">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPriceCommand}" CommandParameter="Offer"/>
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsOfferHighlighted}" Value="True">
                                <Setter Property="StrokeThickness" Value="2" />
                                <Setter Property="BackgroundColor" Value="#333333" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding OfferPrice}" TextColor="White" FontSize="12" FontFamily="RobotoSerifRegular" HorizontalOptions="Center"/>
                    </Border>

                    <Label Text="&gt;" TextColor="White" FontSize="16" FontFamily="RobotoSerifBold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NextPriceCommand}" CommandParameter="Offer"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Label Text="{Binding OfferCount}" TextColor="#CCCCCC" FontSize="10" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="2" 
              ColumnDefinitions="*, 130" 
              Padding="0,0,0,15"
              VerticalOptions="End">

            <Label Grid.Column="0" 
                   Text="Position" 
                   FontFamily="RobotoSerifBold" 
                   FontSize="18" 
                   TextColor="White"
                   VerticalOptions="Center"/>

            <dxe:ComboBoxEdit Grid.Column="1"
                              ItemsSource="{Binding Locations}"
                              DisplayMember="NameInEnglish" 
                              SelectedItem="{Binding SelectedLocation}"
                              BoxMode="Outlined"
                              BackgroundColor="Transparent"
                              TextColor="White"
                              BorderColor="White"
                              IconColor="White"
                              FocusedBorderColor="White"
                              CornerRadius="5"
                              HeightRequest="38"
                              VerticalOptions="Center"/>
        </Grid>

        <VerticalStackLayout Grid.Row="3" Padding="0,5,0,0" Spacing="10" IsVisible="{Binding IsBusy}">
            <Border Stroke="White" StrokeThickness="0.5" BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" Padding="15,10">
                <Grid ColumnDefinitions="50, *" ColumnSpacing="15" VerticalOptions="Center">
                    <Border Grid.Column="0" HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="#222222" StrokeThickness="0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                        <BoxView HeightRequest="12" WidthRequest="100" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                        <BoxView HeightRequest="12" WidthRequest="180" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Stroke="White" StrokeThickness="0.5" BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" Padding="15,10">
                <Grid ColumnDefinitions="50, *" ColumnSpacing="15" VerticalOptions="Center">
                    <Border Grid.Column="0" HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="#222222" StrokeThickness="0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                        <BoxView HeightRequest="12" WidthRequest="80" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                        <BoxView HeightRequest="12" WidthRequest="150" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Stroke="White" StrokeThickness="0.5" BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" Padding="15,10">
                <Grid ColumnDefinitions="50, *" ColumnSpacing="15" VerticalOptions="Center">
                    <Border Grid.Column="0" HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="#222222" StrokeThickness="0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                        <BoxView HeightRequest="12" WidthRequest="120" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                        <BoxView HeightRequest="12" WidthRequest="160" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Stroke="White" StrokeThickness="0.5" BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" Padding="15,10">
                <Grid ColumnDefinitions="50, *" ColumnSpacing="15" VerticalOptions="Center">
                    <Border Grid.Column="0" HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="#222222" StrokeThickness="0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                        <BoxView HeightRequest="12" WidthRequest="120" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                        <BoxView HeightRequest="12" WidthRequest="160" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Stroke="White" StrokeThickness="0.5" BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" Padding="15,10">
                <Grid ColumnDefinitions="50, *" ColumnSpacing="15" VerticalOptions="Center">
                    <Border Grid.Column="0" HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="#222222" StrokeThickness="0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                        <BoxView HeightRequest="12" WidthRequest="120" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                        <BoxView HeightRequest="12" WidthRequest="160" Color="#222222" CornerRadius="4" HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="3" Padding="0,5,0,0">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid" Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </Grid.Triggers>

            <CollectionView ItemsSource="{Binding Positions}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="White" 
                                StrokeThickness="0.5" 
                                BackgroundColor="Transparent" 
                                StrokeShape="RoundRectangle 8"
                                Margin="0,0,0,10"
                                Padding="15,10">

                            <Grid ColumnDefinitions="50, *, Auto" ColumnSpacing="15" VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PositionListingViewModel}}, Path=GoToPositionDetailCommand}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>

                                <Border Grid.Column="0" HeightRequest="50" WidthRequest="50" Stroke="White" StrokeThickness="1" StrokeShape="RoundRectangle 25" BackgroundColor="#1E1E1E" VerticalOptions="Center">
                                    <Label Text="{Binding UserName, Converter={StaticResource NameToInitialsConverter}}" TextColor="White" FontSize="18" FontFamily="RobotoSerifSemibold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding UserName, StringFormat='User: {0}'}" FontFamily="RobotoSerifRegular" FontSize="14" TextColor="White"/>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="Quantity:" FontFamily="RobotoSerifRegular" FontSize="14" TextColor="White"/>
                                        <Label Text="{Binding Quantity, StringFormat='{0:0.##}'}" FontFamily="RobotoSerifRegular" FontSize="14" TextColor="White"/>
                                        <Label Text="{Binding UnitOfMeasure}" FontFamily="RobotoSerifRegular" FontSize="14" TextColor="White"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="2" Text="›" FontFamily="RobotoSerifBold" FontSize="30" TextColor="White" VerticalOptions="Center" HorizontalOptions="End"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding IsListEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <Image Source="no_result_icon.png" HeightRequest="100" Opacity="0.5"/>
                <Label Text="No positions found" FontSize="15" FontFamily="RobotoSerifRegular" HorizontalOptions="Center" TextColor="white"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>