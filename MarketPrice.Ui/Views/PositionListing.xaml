<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             x:Class="MarketPrice.Ui.Views.PositionListing"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="15,10" ColumnSpacing="10" BackgroundColor="White">
            <ImageButton Grid.Column="0" 
                         Source="back_arrow.png" 
                         HeightRequest="24" 
                         Command="{Binding GoBackCommand}"
                         VerticalOptions="Center"/>

            <Border Grid.Column="1" 
                    Stroke="#E0E0E0" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    HeightRequest="40" 
                    Padding="10,0"
                    BackgroundColor="#F5F5F5">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Label Grid.Column="0" Text="🔍" VerticalOptions="Center" TextColor="Gray" Margin="5,0"/>
                    <Entry Grid.Column="1" Placeholder="Search" VerticalOptions="Center" TextColor="Black" BackgroundColor="Transparent"/>
                    <Label Grid.Column="2" Text="✖" VerticalOptions="Center" TextColor="Gray" Margin="0,0,5,0"/>
                </Grid>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1" Padding="0,0,0,20">
            <VerticalStackLayout Spacing="0">

                <Grid ColumnDefinitions="Auto, *" Padding="20,15" ColumnSpacing="15" BackgroundColor="White">
                    <Frame Grid.Column="0" 
                           HeightRequest="60" 
                           WidthRequest="60" 
                           CornerRadius="30" 
                           Padding="0" 
                           IsClippedToBounds="True"
                           BorderColor="Transparent">
                        <Image Source="{Binding CommodityImage}" Aspect="AspectFill"/>
                    </Frame>

                    <Label Grid.Column="1" 
                           Text="{Binding PageTitle}" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="Black" 
                           VerticalOptions="Center"/>
                </Grid>

                <CollectionView ItemsSource="{Binding Filters}" 
                                HeightRequest="60"
                                HorizontalScrollBarVisibility="Never"
                                SelectionMode="None"
                                BackgroundColor="White">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="{Binding BorderColor}" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 20" 
                                    BackgroundColor="{Binding BackgroundColor}"
                                    Padding="20,8"
                                    VerticalOptions="Center"
                                    Margin="5,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PositionListingViewModel}}, Path=SelectFilterCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Label Text="{Binding Title}" 
                                       TextColor="{Binding TextColor}" 
                                       FontAttributes="Bold"
                                       FontSize="14"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout Padding="20,20,20,10" Spacing="5">
                    <Label Text="Position Listings - BIDS" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="Black" 
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding UnitPrice, StringFormat='Unit Price: {0}'}" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="Black"/>
                </VerticalStackLayout>

                <CollectionView ItemsSource="{Binding Positions}" 
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="20,0,20,15">
                                <Border Stroke="#007BFF" 
                                        StrokeThickness="1" 
                                        StrokeShape="RoundRectangle 15" 
                                        Padding="15"
                                        BackgroundColor="White">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PositionListingViewModel}}, Path=GoToDetailsCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                        <Border Grid.Column="0"
                                                HeightRequest="60"
                                                WidthRequest="60"
                                                Stroke="#007BFF"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 30"
                                                BackgroundColor="White"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center">
                                            <Label Text="{Binding Initials}" 
                                                   TextColor="#333" 
                                                   FontSize="20" 
                                                   FontAttributes="Bold" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label>
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="User Name: " FontAttributes="Bold" TextColor="Black" FontSize="13"/>
                                                        <Span Text="{Binding UserName}" TextColor="#333" FontSize="13"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label>
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Quantity: " FontAttributes="Bold" TextColor="Black" FontSize="13"/>
                                                        <Span Text="{Binding Quantity}" TextColor="#333" FontSize="13"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label>
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Commodity: " FontAttributes="Bold" TextColor="Black" FontSize="13"/>
                                                        <Span Text="{Binding CommodityType}" TextColor="#333" FontSize="13"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" 
                                               Text="›" 
                                               FontSize="30" 
                                               TextColor="Black" 
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>