<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MarketPrice.Ui.Views.Home"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             xmlns:models="clr-namespace:MarketPrice.Ui.Models"
             xmlns:converters="clr-namespace:MarketPrice.Ui.Converters"
             x:DataType="viewModels:HomeViewModel"
             BackgroundColor="{StaticResource BgPage}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:NotZeroConverter x:Key="NotZeroConverter"/>
        <converters:TrendColorConverter x:Key="TrendBidColor" IsOffer="False"/>
        <converters:TrendColorConverter x:Key="TrendOfferColor" IsOffer="True"/>
    </ContentPage.Resources>

        <Grid RowDefinitions="Auto,Auto,*"
          BackgroundColor="{StaticResource BgPage}">

        <!-- ── HEADER ── -->
        <Grid Grid.Row="0"
              BackgroundColor="#0A0D14"
              Padding="16,48,16,14"
              ColumnDefinitions="44,*,44">

            <Border Grid.Column="0"
                    BackgroundColor="#1A1E2E"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderColor}"
                    WidthRequest="38"
                    HeightRequest="38"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="19"/>
                </Border.StrokeShape>
                <Image Source="marketprice_logo.svg" Aspect="AspectFit" Margin="6"/>
            </Border>

            <Label Grid.Column="1"
                   Text="MarketPrice"
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="17"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <Label Grid.Column="2"
                   Text="⋮"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="22"
                   VerticalOptions="Center"
                   HorizontalOptions="End"/>
        </Grid>

        <!-- ── SEARCH ── -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource SearchBg}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                Margin="16,10,16,6"
                HeightRequest="42">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="32,*" Padding="10,0">
                <Label Text="🔍"
                       FontSize="14"
                       VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Search commodities..."
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                      />
            </Grid>
        </Border>

        
        
        <dxcv:DXCollectionView
            Grid.Row="2"
            ItemsSource="{Binding Commodities}"
            SelectionMode="None">

            <dxcv:DXCollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CommodityGroupDisplayModel">
                    <VerticalStackLayout Padding="0,0,0,4">

                       
                        <Label Text="{Binding GroupName}"
                               TextColor="#475569"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="2.5"
                               Margin="16,14,16,6"/>

                        <!-- OUTER CARD -->
                        <Border Margin="12,0"
                                BackgroundColor="{StaticResource BgCard}"
                                Stroke="{StaticResource BorderColor}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout>

                                <!-- COLUMN HEADERS -->
                                <Grid ColumnDefinitions="90,*,*"
                                      Padding="12,10,12,8">
                                    <Label Text="Type"
                                           TextColor="#334155"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1.5"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="BID"
                                           TextColor="#334155"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1.5"
                                           HorizontalTextAlignment="Center"/>
                                    <Label Grid.Column="2"
                                           Text="OFFER"
                                           TextColor="#334155"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1.5"
                                           HorizontalTextAlignment="Center"/>
                                </Grid>

                                <BoxView HeightRequest="0.5"
                                         Color="{StaticResource BorderColor}"
                                         Margin="12,0,12,0"/>

                                <!-- HORIZONTAL SCROLL — FIX: typo corrected + fixed height -->
                                <CollectionView
                                    ItemsSource="{Binding Commodities}"
                                    HeightRequest="210"
                                    Margin="0,6,0,8"
                                    HorizontalScrollBarVisibility="Never"
                                    VerticalScrollBarVisibility="Never">

                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal"
                                                           ItemSpacing="6"/>
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CommodityDisplayModel">

                                           
                                            <Border WidthRequest="280"
                                                    Margin="12,4,0,4"
                                                    BackgroundColor="{StaticResource BgCardInner}"
                                                    Stroke="{StaticResource BorderColor}"
                                                    StrokeThickness="1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10"/>
                                                </Border.StrokeShape>

                                                <Grid ColumnDefinitions="90,*,*"
                                                     
                                                      Padding="0,10,0,10">

                                                    <!-- LEFT: image + name + lot size -->
                                                    <VerticalStackLayout
                                                        Grid.Column="0"
                                                        
                                                        Spacing="6"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        Padding="4,0">

                                                        <Border WidthRequest="44"
                                                                HeightRequest="44"
                                                                BackgroundColor="#252836"
                                                                Stroke="{StaticResource BorderColor}"
                                                                StrokeThickness="1"
                                                                HorizontalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="22"/>
                                                            </Border.StrokeShape>
                                                            <Image Source="{Binding ImageUrl}"
                                                                   Aspect="AspectFill"
                                                                   WidthRequest="44"
                                                                   HeightRequest="44"/>
                                                        </Border>

                                                        <Label Text="{Binding Name}"
                                                               TextColor="{StaticResource TextPrimary}"
                                                               FontSize="10"
                                                               FontAttributes="Bold"
                                                               HorizontalTextAlignment="Center"
                                                               MaxLines="2"
                                                               LineBreakMode="WordWrap"/>

                                                        <Label Text="{Binding LotSizeDisplay}"
                                                               FontSize="9"
                                                               TextColor="{StaticResource TextMuted}"
                                                               HorizontalTextAlignment="Center"/>
                                                    </VerticalStackLayout>

                                                    <!-- BID COLUMN -->
                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        
                                                        Spacing="3"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Center">

                                                        <Border BackgroundColor="#0D1F0D"
                                                                Stroke="#1A3A1A"
                                                                StrokeThickness="1"
                                                                Padding="8,6"
                                                                Margin="0,0,0,6">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7"/>
                                                            </Border.StrokeShape>
                                                            <Grid ColumnDefinitions="*,18" RowDefinitions="Auto,Auto">
                                                                <Label Grid.Row="0" Grid.Column="0"
                                                                       Text="{Binding BestBidPrice, StringFormat='{0:N0}'}"
                                                                       TextColor="#22C55E"
                                                                       FontSize="14"
                                                                       FontAttributes="Bold"/>

                                                                <Label Grid.Row="1" Grid.Column="0"
                                                                       Text="{Binding BestBidLocation}"
                                                                       TextColor="{StaticResource AccentGreen}"
                                                                       FontSize="8"/>
                                                                <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                                                     Grid.RowSpan="2"
                                                                                     HorizontalOptions="End"
                                                                                     VerticalOptions="Center"
                                                                                     Spacing="1">

                                                                    <Label Grid.Column="2"
                                                                     Text="{Binding IsBidImproved, Converter={StaticResource TrendArrowConverter}}"
                                                                     TextColor="{Binding IsBidImproved, Converter={StaticResource TrendBidColor}}"
                                                                     FontSize="10"
                                                                     HorizontalTextAlignment="Center"/>

                                                                    <Label Text="{Binding BestBidQuantity, StringFormat='{0:N0}'}"
                                                                           TextColor="#334155"
                                                                           FontSize="8"
                                                                           HorizontalTextAlignment="Center"/>
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>

                                                        <Grid ColumnDefinitions="*,Auto"
                                                              IsVisible="{Binding NextBid1, Converter={StaticResource NotZeroConverter}}"
                                                              Padding="2,2,2,0">

                                                            <Label Text="{Binding NextBid1, StringFormat='{0:N0}'}"
                                                                   TextColor="{StaticResource AccentGreen}"
                                                                   FontSize="11"/>
                                                                   
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding NextBid1Location}"
                                                                   TextColor="{StaticResource TextMuted}"
                                                                   FontSize="8"
                                                                   VerticalOptions="Center"/>
        
                                                        </Grid>
                                                        
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              IsVisible="{Binding NextBid2, Converter={StaticResource NotZeroConverter}}"
                                                              Padding="2,2,2,0">
                                                            <Label Text="{Binding NextBid2, StringFormat='{0:N0}'}"
                                                                   TextColor="#166534"
                                                                   FontSize="11"/>
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding NextBid2Location}"
                                                                   TextColor="#14532D"
                                                                   FontSize="8"
                                                                   VerticalOptions="Center"/>
                                                        </Grid>

                                                    </VerticalStackLayout>

                                                    <!-- OFFER COLUMN -->
                                                    <VerticalStackLayout
                                                        Grid.Column="2"
                                                        Spacing="0"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Center">

                                                        <Border BackgroundColor="#1A0D0D"
                                                                Stroke="#3a1a1a"
                                                                StrokeThickness="1"
                                                                Padding="8,6"
                                                                Margin="0,0,0,6">
                                                                
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7"/>
                                                            </Border.StrokeShape>
                                                            <Grid ColumnDefinitions="*,16" RowDefinitions="Auto,Auto">
                                                                <Label Grid.Row="0" Grid.Column="0"
                                                                       Text="{Binding BestOfferPrice, StringFormat='{0:N0}'}"
                                                                       TextColor="#EF4444"
                                                                       FontSize="14"
                                                                       FontAttributes="Bold"/>
                                                                <Label Grid.Row="1" Grid.Column="0"
                                                                       Text="{Binding BestOfferLocation}"
                                                                       TextColor="#7F1D1D"
                                                                       FontSize="8"/>
                                                                <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                                                     Grid.RowSpan="2"
                                                                                     HorizontalOptions="End"
                                                                                     VerticalOptions="Center"
                                                                                     Spacing="1">
                                                                    <Label Text="{Binding IsOfferImproved, Converter={StaticResource TrendArrowConverter}}"
                                                                           TextColor="{Binding IsOfferImproved, Converter={StaticResource TrendOfferColor}}"
                                                                           FontSize="10"
                                                                           HorizontalTextAlignment="Center"/>
                                                                    <Label Text="{Binding BestOfferQuantity, StringFormat='{0:N0}'}"
                                                                           TextColor="#334155"
                                                                           FontSize="8"
                                                                           HorizontalTextAlignment="Center"/>
                                                                </VerticalStackLayout>
                                                            </Grid>
                                                        </Border>

                                                        <Grid ColumnDefinitions="*,Auto"
                                                              IsVisible="{Binding NextOffer1, Converter={StaticResource NotZeroConverter}}"
                                                              Padding="2,2,2,0">
                                                            <Label Text="{Binding NextOffer1, StringFormat='{0:N0}'}"
                                                                   TextColor="#DC2626"
                                                                   FontSize="11"/>
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding NextOffer1Location}"
                                                                   TextColor="#7F1D1D"
                                                                   FontSize="8"
                                                                   VerticalOptions="Center"/>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="*,Auto"
                                                              IsVisible="{Binding NextOffer2, Converter={StaticResource NotZeroConverter}}"
                                                              Padding="2,2,2,0">
                                                            <Label Text="{Binding NextOffer2, StringFormat='{0:N0}'}"
                                                                   TextColor="#B91C1C"
                                                                   FontSize="11"/>
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding NextOffer2Location}"
                                                                   TextColor="#7F1D1D"
                                                                   FontSize="8"
                                                                   VerticalOptions="Center"/>
                                                        </Grid>
                                                    </VerticalStackLayout>

                                                </Grid>
                                            </Border>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <!-- FOOTER HINT -->
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="14,0,14,10">
                                    <Label Text="← Swipe to explore →"
                                           TextColor="#1E2235"
                                           FontSize="9"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Commodities.Count, StringFormat='{0} types'}"
                                           TextColor="#1E2235"
                                           FontSize="9"/>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </dxcv:DXCollectionView.ItemTemplate>
        </dxcv:DXCollectionView>

    </Grid>
</ContentPage>