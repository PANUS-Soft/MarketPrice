<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MarketPrice.Ui.Views.Home"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             xmlns:models="clr-namespace:MarketPrice.Ui.Models"
             x:DataType="viewModels:HomeViewModel"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Grid RowDefinitions="Auto, Auto, *, Auto" BackgroundColor="{StaticResource BgPage}">

            <Grid Grid.Row="0"
                  BackgroundColor="#0D0F18"
                  Padding="16,48,16,12"
                  ColumnDefinitions="48,*,48">
                <Frame Grid.Column="0"
                       BackgroundColor="#1E2130"
                       BorderColor="{StaticResource BorderColor}"
                       CornerRadius="24" Padding="0"
                       WidthRequest="40" HeightRequest="40"
                       IsClippedToBounds="True">
                    <Image Source="marketprice_logo.svg"
                           HeightRequest="90"
                           Aspect="AspectFit"
                           HorizontalOptions="Start"/>
                </Frame>
                <Label Grid.Column="1"
                       Text="MarketPrice"
                       TextColor="{StaticResource TextPrimary}"
                       FontSize="17"
                       FontAttributes="Bold"
                       HorizontalOptions="Start"
                       VerticalOptions="Center"/>
                <Label Grid.Column="2"
                       Text="⋮"
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="24"
                       VerticalOptions="Center"
                       HorizontalOptions="End"/>
            </Grid>


            <Frame Grid.Row="1"
               BackgroundColor="{StaticResource SearchBg}"
               BorderColor="{StaticResource BorderColor}"
               CornerRadius="12"
               Margin="16,8,16,8"
               Padding="12,0"
               HeightRequest="44">
                <Grid ColumnDefinitions="24,*">
                    <Label Grid.Column="0" Text="🔍"
                       FontSize="14" VerticalOptions="Center"/>
                    <Entry Grid.Column="1"
                       Text="{Binding SearchText}"
                       Placeholder="Search commodities..."
                       PlaceholderColor="{StaticResource TextMuted}"
                       TextColor="{StaticResource TextPrimary}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       Margin="6,0,0,0"/>
                </Grid>
            </Frame>

            <dxcv:DXCollectionView
               Grid.Row="2"
               x:Name="CommodityList"
               ItemsSource="{Binding Commodities}"
               SelectionMode="None"
               UseRippleEffect="False"
               Margin="0,0">

                <dxcv:DXCollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CommodityGroup">
                        <VerticalStackLayout Padding="0,0,0,4">
                            <Label Text="{Binding GroupName}"
                                   TextColor="#64748B"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="2"
                                   Margin="16,14,16,6"/>

                            <Frame Margin="12,0,12,4"
                                   BackgroundColor="{StaticResource BgCard}"
                                   BorderColor="{StaticResource BorderColor}"
                                   CornerRadius="16"
                                   Padding="0"
                                   HasShadow="False"
                                   IsClippedToBounds="True">
                                <VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,2*,2*"
                                          Padding="14,10,14,6">
                                        <Label Grid.Column="0"
                                              Text="Type"
                                              TextColor="#475569"
                                              FontSize="10" FontAttributes="Bold"
                                              CharacterSpacing="1"/>
                                        <Label Grid.Column="1"
                                               Text="BEST BID"
                                               TextColor="#475569"
                                               FontSize="10" FontAttributes="Bold"
                                               CharacterSpacing="1"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Grid.Column="2"
                                           Text="BEST OFFER"
                                           TextColor="#475569"
                                           FontSize="10" FontAttributes="Bold"
                                           CharacterSpacing="1"
                                           HorizontalTextAlignment="Center"/>
                                    </Grid>
                                    <BoxView HeightRequest="0.5"
                                         Color="{StaticResource BorderColor}"
                                         Margin="12,0"/>

                                    <ScrollView Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never"
                                            VerticalScrollBarVisibility="Never"
                                            Padding="0,8,0,10">

                                        <HorizontalStackLayout
                                        BindableLayout.ItemsSource="{Binding Types}"
                                        Spacing="8"
                                        Padding="12,0,12,0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:CommodityType">

                                                    <Frame WidthRequest="255"
                                                       BackgroundColor="{StaticResource BgCardInner}"
                                                       BorderColor="{StaticResource BorderColor}"
                                                       CornerRadius="12"
                                                       Padding="10,10"
                                                       HasShadow="False">
                                                        <Grid ColumnDefinitions="80,*,*"
                                                          RowDefinitions="Auto,Auto,Auto">

                                                            <VerticalStackLayout
                                                            Grid.Column="0" Grid.RowSpan="3"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center"
                                                            Spacing="5">

                                                                <Frame WidthRequest="48" HeightRequest="48"
                                                                   CornerRadius="24"
                                                                   Padding="0"
                                                                   BackgroundColor="#252836"
                                                                   BorderColor="{StaticResource BorderColor}"
                                                                   IsClippedToBounds="True"
                                                                   HorizontalOptions="Center">
                                                                    <Image Source="{Binding ImageSource}"
                                                                       Aspect="AspectFill"
                                                                       WidthRequest="48"
                                                                       HeightRequest="48"/>
                                                                </Frame>

                                                                <Label Text="{Binding Name}"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"
                                                                   MaxLines="2"
                                                                   LineBreakMode="WordWrap"
                                                                   HorizontalOptions="Center"/>

                                                                <Label Text="{Binding LotSize}"
                                                                   TextColor="{StaticResource TextMuted}"
                                                                   FontSize="9"
                                                                   HorizontalTextAlignment="Center"
                                                                   HorizontalOptions="Center"/>
                                                            </VerticalStackLayout>

                                                            <VerticalStackLayout
                                                            Grid.Column="1" Grid.RowSpan="3"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center"
                                                            Spacing="3"
                                                            Padding="4,0">

                                                                <Frame BackgroundColor="#162414"
                                                                   BorderColor="#1a3a1a"
                                                                   CornerRadius="8"
                                                                   Padding="6,5"
                                                                   HorizontalOptions="Fill">
                                                                    <Grid ColumnDefinitions="16,*,16">
                                                                        <Label Grid.Column="0"
                                                                           Text="{Binding BidQuantity}"
                                                                           TextColor="#475569"
                                                                           FontSize="9"
                                                                           VerticalOptions="Center"/>
                                                                        <Label Grid.Column="1"
                                                                           Text="{Binding BidPrice}"
                                                                           TextColor="{StaticResource AccentGreen}"
                                                                           FontSize="14"
                                                                           FontAttributes="Bold"
                                                                           HorizontalTextAlignment="Center"
                                                                           VerticalOptions="Center"/>
                                                                        <Label Grid.Column="2"
                                                                           Text="{Binding BidTrendUp, Converter={StaticResource TrendArrowConverter}}"
                                                                           TextColor="{StaticResource AccentGreen}"
                                                                           FontSize="12"
                                                                           VerticalOptions="Center"
                                                                           HorizontalTextAlignment="End"/>
                                                                    </Grid>
                                                                </Frame>

                                                                <Label Text="{Binding BidLow1}"
                                                                   TextColor="{StaticResource AccentGreen}"
                                                                   FontSize="11"
                                                                   HorizontalTextAlignment="Center"/>
                                                                <Label Text="{Binding BidLow2}"
                                                                   TextColor="{StaticResource TextMuted}"
                                                                   FontSize="11"
                                                                   HorizontalTextAlignment="Center"/>
                                                            </VerticalStackLayout>

                                                            <VerticalStackLayout
                                                            Grid.Column="2" Grid.RowSpan="3"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center"
                                                            Spacing="3"
                                                            Padding="4,0">

                                                                <Frame BackgroundColor="#241616"
                                                                   BorderColor="#3a1a1a"
                                                                   CornerRadius="8"
                                                                   Padding="6,5"
                                                                   HorizontalOptions="Fill">
                                                                    <Grid ColumnDefinitions="16,*,16">
                                                                        <Label Grid.Column="0"
                                                                           Text="{Binding OfferQuantity}"
                                                                           TextColor="#475569"
                                                                           FontSize="9"
                                                                           VerticalOptions="Center"/>
                                                                        <Label Grid.Column="1"
                                                                               Text="{Binding OfferPrice}"
                                                                               TextColor="{StaticResource AccentRed}"
                                                                               FontSize="14"
                                                                               FontAttributes="Bold"
                                                                               HorizontalTextAlignment="Center"
                                                                               VerticalOptions="Center"/>
                                                                        <Label Grid.Column="2"
                                                                               Text="{Binding OfferTrendUp, Converter={StaticResource TrendArrowConverter}}"
                                                                               TextColor="{StaticResource AccentRed}"
                                                                               FontSize="12"
                                                                               VerticalOptions="Center"
                                                                               HorizontalTextAlignment="End"/>
                                                                    </Grid>
                                                                </Frame>

                                                                <Label Text="{Binding OfferLow1}"
                                                                       TextColor="{StaticResource AccentBlue}"
                                                                       FontSize="11"
                                                                       HorizontalTextAlignment="Center"/>
                                                                <Label Text="{Binding OfferLow2}"
                                                                       TextColor="{StaticResource TextMuted}"
                                                                       FontSize="11"
                                                                       HorizontalTextAlignment="Center"/>
                                                            </VerticalStackLayout>

                                                        </Grid>
                                                    </Frame>

                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </ScrollView>

                                    <Grid Padding="14,2,14,12"
                                          ColumnDefinitions="16,*">
                                        <Label Grid.Column="0" Text="📍"
                                               FontSize="11" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Swipe cards to explore types →"
                                               TextColor="{StaticResource TextMuted}"
                                               FontSize="10"
                                               VerticalOptions="Center"
                                               Margin="4,0,0,0"/>
                                    </Grid>
                                    
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </DataTemplate>
                </dxcv:DXCollectionView.ItemTemplate>
            </dxcv:DXCollectionView>
        </Grid>
    </Grid>
</ContentPage>