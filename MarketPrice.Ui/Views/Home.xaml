<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MarketPrice.Ui.Views.Home"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             xmlns:models="clr-namespace:MarketPrice.Ui.Models"
             xmlns:converters="clr-namespace:MarketPrice.Ui.Converters"
             x:DataType="viewModels:HomeViewModel"
             BackgroundColor="{StaticResource BgPage}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:NotZeroConverter x:Key="NotZeroConverter"/>
        <converters:TrendColorConverter x:Key="TrendBidColor" IsOffer="False"/>
        <converters:TrendColorConverter x:Key="TrendOfferColor" IsOffer="True"/>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <converters:StringEmptyConverter x:Key="StringEmptyConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="{StaticResource BgPage}">

        <!-- ── ROW 0: HEADER ── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgHeader}"
              Padding="16,48,16,14"
              ColumnDefinitions="44,*,44">

            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource BgChip}"
                    Stroke="Transparent" StrokeThickness="0"
                    WidthRequest="38" HeightRequest="38"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="19"/>
                </Border.StrokeShape>
                <Image Source="marketprice_logo.svg" Aspect="AspectFit" Margin="6"/>
            </Border>

            <Label Grid.Column="1"
                   Text="MarketPrice"
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="17" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>

            <Label Grid.Column="2"
                   Text="⋮"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="22"
                   VerticalOptions="Center" HorizontalOptions="End"/>
        </Grid>

        <!-- ── ROW 1: SEARCH BAR (tappable placeholder) ── -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource SearchBg}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                Margin="16,10,16,8"
                HeightRequest="44">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ActivateSearchCommand}"/>
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="32,*,32" Padding="10,0">
                <Label Text="🔍" FontSize="13"
                       TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="Search commodities..."
                       TextColor="{StaticResource TextMuted}"
                       FontSize="13" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ActivateSearchCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- ── ROW 2: MAIN COMMODITY LIST ── -->
        <dxcv:DXCollectionView
            Grid.Row="2"
            ItemsSource="{Binding Commodities}"
            SelectionMode="None">

            <dxcv:DXCollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CommodityGroupDisplayModel">
                    <VerticalStackLayout Padding="0,0,0,4">

                        <!-- Group label e.g. "BEANS" -->
                        <Label Text="{Binding GroupName}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="10" FontAttributes="Bold"
                               CharacterSpacing="2.5"
                               Margin="16,14,16,6"/>

                        <!-- Outer group card -->
                        <Border Margin="12,0"
                                BackgroundColor="{StaticResource BgCard}"
                                Stroke="Transparent" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Padding="0,8,0,10">

                                <!-- Horizontal scroll of commodity cards -->
                                <CollectionView
                                    ItemsSource="{Binding Commodities}"
                                    MinimumHeightRequest="140"
                                    HorizontalScrollBarVisibility="Never"
                                    VerticalScrollBarVisibility="Never">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CommodityDisplayModel">

                                            <!-- Inner commodity card -->
                                            <Border WidthRequest="300"
                                                    Margin="10,4,0,4"
                                                    BackgroundColor="{StaticResource BgCard}"
                                                    Stroke="Transparent" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>

                                                <Grid RowDefinitions="Auto,Auto,Auto"
                                                      ColumnDefinitions="*,*,*">

                                                    <!-- ══ ROW 1: HEADERS ══ -->
                                                    <Label Grid.Row="0" Grid.Column="0"
                                                           Text="TYPE"
                                                           TextColor="{StaticResource TextLabel}"
                                                           FontSize="8" FontAttributes="Bold"
                                                           CharacterSpacing="1.2"
                                                           Margin="10,9,0,5"
                                                           VerticalOptions="Center"/>

                                                    <Grid Grid.Row="0" Grid.Column="1"
                                                          ColumnDefinitions="*,Auto"
                                                          Margin="4,9,4,5">
                                                        <Label Text="BID"
                                                               TextColor="{StaticResource TextLabel}"
                                                               FontSize="8" FontAttributes="Bold"
                                                               CharacterSpacing="1.2"
                                                               VerticalOptions="Center"/>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding BestBidQuantity, StringFormat='×{0:N0}'}"
                                                               TextColor="{StaticResource AccentGreenFaint}"
                                                               FontSize="8" VerticalOptions="Center"/>
                                                    </Grid>

                                                    <Grid Grid.Row="0" Grid.Column="2"
                                                          ColumnDefinitions="*,Auto"
                                                          Margin="4,9,10,5">
                                                        <Label Text="OFFER"
                                                               TextColor="{StaticResource TextLabel}"
                                                               FontSize="8" FontAttributes="Bold"
                                                               CharacterSpacing="1.2"
                                                               VerticalOptions="Center"/>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding BestOfferQuantity, StringFormat='×{0:N0}'}"
                                                               TextColor="{StaticResource AccentRedFaint}"
                                                               FontSize="8" VerticalOptions="Center"/>
                                                    </Grid>

                                                    <BoxView Grid.Row="0" Grid.Column="0"
                                                             Grid.ColumnSpan="3"
                                                             HeightRequest="0.5"
                                                             Color="{StaticResource BgChip}"
                                                             VerticalOptions="End"/>

                                                    <!-- ══ ROW 2: MAIN DATA ══ -->

                                                    <!-- TYPE: image + name + lot -->
                                                    <Grid Grid.Row="1" Grid.Column="0"
                                                          ColumnDefinitions="Auto,*"
                                                          Margin="8,10,4,10"
                                                          ColumnSpacing="7">
                                                        <Border Grid.Column="0"
                                                                WidthRequest="36" HeightRequest="36"
                                                                BackgroundColor="{StaticResource BgChip}"
                                                                Stroke="Transparent" StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="18"/>
                                                            </Border.StrokeShape>
                                                            <Image Source="{Binding ImageUrl}"
                                                                   Aspect="AspectFill"
                                                                   WidthRequest="36" HeightRequest="36"/>
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1"
                                                                             VerticalOptions="Center"
                                                                             Spacing="3">
                                                            <Label Text="{Binding Name}"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   FontSize="10" FontAttributes="Bold"
                                                                   MaxLines="2"
                                                                   LineBreakMode="WordWrap"/>
                                                            <Label Text="{Binding LotSizeDisplay}"
                                                                   TextColor="{StaticResource TextMuted}"
                                                                   FontSize="8"/>
                                                        </VerticalStackLayout>
                                                    </Grid>

                                                    <!-- BID: price box + depth -->
                                                    <VerticalStackLayout
                                                        Grid.Row="1" Grid.Column="1"
                                                        Margin="4,10,4,10"
                                                        Spacing="5"
                                                        VerticalOptions="Start">
                                                        <Border BackgroundColor="{StaticResource AccentGreenBg}"
                                                                Stroke="{StaticResource AccentGreenBorder}"
                                                                StrokeThickness="1" Padding="6,6">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding BestBidDisplay}"
                                                                   TextColor="{StaticResource AccentGreen}"
                                                                   FontSize="13" FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"/>
                                                        </Border>
                                                        <Label Text="{Binding NextBid1, StringFormat='{0:N0}'}"
                                                               TextColor="{StaticResource AccentGreenDim}"
                                                               FontSize="10"
                                                               IsVisible="{Binding NextBid1, Converter={StaticResource NotZeroConverter}}"
                                                               HorizontalTextAlignment="Center"/>
                                                        <Label Text="{Binding NextBid2, StringFormat='{0:N0}'}"
                                                               TextColor="{StaticResource AccentGreenFaint}"
                                                               FontSize="10"
                                                               IsVisible="{Binding NextBid2, Converter={StaticResource NotZeroConverter}}"
                                                               HorizontalTextAlignment="Center"/>
                                                    </VerticalStackLayout>

                                                    <!-- OFFER: price box + depth -->
                                                    <VerticalStackLayout
                                                        Grid.Row="1" Grid.Column="2"
                                                        Margin="4,10,10,10"
                                                        Spacing="5"
                                                        VerticalOptions="Start">
                                                        <Border BackgroundColor="{StaticResource AccentRedBg}"
                                                                Stroke="{StaticResource AccentRedBorder}"
                                                                StrokeThickness="1" Padding="6,6">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding BestOfferDisplay}"
                                                                   TextColor="{StaticResource AccentRed}"
                                                                   FontSize="13" FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"/>
                                                        </Border>
                                                        <Label Text="{Binding NextOffer1, StringFormat='{0:N0}'}"
                                                               TextColor="{StaticResource AccentRedDim}"
                                                               FontSize="10"
                                                               IsVisible="{Binding NextOffer1, Converter={StaticResource NotZeroConverter}}"
                                                               HorizontalTextAlignment="Center"/>
                                                        <Label Text="{Binding NextOffer2, StringFormat='{0:N0}'}"
                                                               TextColor="{StaticResource AccentRedFaint}"
                                                               FontSize="10"
                                                               IsVisible="{Binding NextOffer2, Converter={StaticResource NotZeroConverter}}"
                                                               HorizontalTextAlignment="Center"/>
                                                    </VerticalStackLayout>

                                                    <!-- ══ ROW 3: LOCATION FOOTER ══ -->
                                                    <BoxView Grid.Row="2" Grid.Column="0"
                                                             Grid.ColumnSpan="3"
                                                             HeightRequest="0.5"
                                                             Color="{StaticResource BgChip}"/>
                                                    <Label Grid.Row="2" Grid.Column="0"
                                                           Text="REGION"
                                                           TextColor="{StaticResource TextMuted}"
                                                           FontSize="7" FontAttributes="Bold"
                                                           CharacterSpacing="1"
                                                           Margin="10,6,0,7"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Row="2" Grid.Column="1"
                                                           Text="{Binding BestBidLocation}"
                                                           TextColor="{StaticResource AccentGreenFaint}"
                                                           FontSize="8"
                                                           Margin="4,6,4,7"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Row="2" Grid.Column="2"
                                                           Text="{Binding BestOfferLocation}"
                                                           TextColor="{StaticResource AccentRedFaint}"
                                                           FontSize="8"
                                                           Margin="4,6,10,7"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                            </Border>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Label Text="← swipe to explore →"
                                       TextColor="{StaticResource BgChip}"
                                       FontSize="8"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,4,0,2"/>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </dxcv:DXCollectionView.ItemTemplate>
        </dxcv:DXCollectionView>

        <!-- ══ SEARCH OVERLAY ══ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              x:Name="SearchOverlay"
              BackgroundColor="{StaticResource BgPage}"
              IsVisible="{Binding IsSearchActive}"
              RowDefinitions="Auto,Auto,*">

            <!-- Overlay Row 0: Search bar + Cancel -->
            <Grid Grid.Row="0"
                  BackgroundColor="{StaticResource BgHeader}"
                  Padding="16,48,12,14"
                  ColumnDefinitions="*,Auto">

                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource BgCard}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1"
                        HeightRequest="42">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="32,*,32" Padding="8,0">
                        <Label Text="🔍"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                        <Entry Grid.Column="1"
                               x:Name="SearchEntry"
                               Text="{Binding SearchText}"
                               Placeholder="Search commodities..."
                               PlaceholderColor="{StaticResource TextMuted}"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="Transparent"
                               FontSize="13"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2"
                               Text="✕"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="12"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               IsVisible="{Binding SearchText, Converter={StaticResource StringNotEmptyConverter}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearSearchCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

                <Label Grid.Column="1"
                       Text="Cancel"
                       TextColor="{StaticResource TabActive}"
                       FontSize="14"
                       Margin="12,0,4,0"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelSearchCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Overlay Row 1: Empty state -->
            <VerticalStackLayout Grid.Row="1"
                                 IsVisible="{Binding SearchText, Converter={StaticResource StringEmptyConverter}}"
                                 HorizontalOptions="Center"
                                 Margin="0,60,0,0"
                                 Spacing="8">
                <Label Text="🔍" FontSize="36" HorizontalOptions="Center"/>
                <Label Text="Search for a commodity"
                       TextColor="{StaticResource TextSecondary}"
                       FontSize="14" HorizontalOptions="Center"/>
                <Label Text="e.g. Red Beans, Corn, Egusi"
                       TextColor="{StaticResource TextMuted}"
                       FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Overlay Row 2: Search results -->
            <dxcv:DXCollectionView
                Grid.Row="2"
                ItemsSource="{Binding SearchResults}"
                SelectionMode="None"
                IsVisible="{Binding SearchText, Converter={StaticResource StringNotEmptyConverter}}">

                <dxcv:DXCollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CommodityGroupDisplayModel">
                        <VerticalStackLayout Padding="0,0,0,4">

                            <Label Text="{Binding GroupName}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="10" FontAttributes="Bold"
                                   CharacterSpacing="2.5"
                                   Margin="16,14,16,6"/>

                            <Border Margin="12,0"
                                    BackgroundColor="{StaticResource BgCard}"
                                    Stroke="Transparent" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Padding="0,8,0,10">
                                    <CollectionView
                                        ItemsSource="{Binding Commodities}"
                                        MinimumHeightRequest="140"
                                        HorizontalScrollBarVisibility="Never"
                                        VerticalScrollBarVisibility="Never">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:CommodityDisplayModel">
                                                <Border WidthRequest="300"
                                                        Margin="10,4,0,4"
                                                        BackgroundColor="{StaticResource BgCardInner}"
                                                        Stroke="Transparent" StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8"/>
                                                    </Border.StrokeShape>
                                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                                          ColumnDefinitions="*,*,*">

                                                        <Label Grid.Row="0" Grid.Column="0"
                                                               Text="TYPE" TextColor="{StaticResource TextLabel}"
                                                               FontSize="8" FontAttributes="Bold"
                                                               CharacterSpacing="1.2" Margin="10,9,0,5"/>
                                                        <Grid Grid.Row="0" Grid.Column="1"
                                                              ColumnDefinitions="*,Auto" Margin="4,9,4,5">
                                                            <Label Text="BID" TextColor="{StaticResource TextLabel}"
                                                                   FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2"/>
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding BestBidQuantity, StringFormat='×{0:N0}'}"
                                                                   TextColor="{StaticResource AccentGreenFaint}" FontSize="8"/>
                                                        </Grid>
                                                        <Grid Grid.Row="0" Grid.Column="2"
                                                              ColumnDefinitions="*,Auto" Margin="4,9,10,5">
                                                            <Label Text="OFFER" TextColor="{StaticResource TextLabel}"
                                                                   FontSize="8" FontAttributes="Bold" CharacterSpacing="1.2"/>
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding BestOfferQuantity, StringFormat='×{0:N0}'}"
                                                                   TextColor="{StaticResource AccentRedFaint}" FontSize="8"/>
                                                        </Grid>
                                                        <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                                 HeightRequest="0.5" Color="{StaticResource BgChip}"
                                                                 VerticalOptions="End"/>

                                                        <Grid Grid.Row="1" Grid.Column="0"
                                                              ColumnDefinitions="Auto,*"
                                                              Margin="8,10,4,10" ColumnSpacing="7">
                                                            <Border Grid.Column="0"
                                                                    WidthRequest="36" HeightRequest="36"
                                                                    BackgroundColor="{StaticResource BgChip}"
                                                                    Stroke="Transparent" StrokeThickness="0"
                                                                    VerticalOptions="Center">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="18"/>
                                                                </Border.StrokeShape>
                                                                <Image Source="{Binding ImageUrl}"
                                                                       Aspect="AspectFill"
                                                                       WidthRequest="36" HeightRequest="36"/>
                                                            </Border>
                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 VerticalOptions="Center" Spacing="3">
                                                                <Label Text="{Binding Name}"
                                                                       TextColor="{StaticResource TextPrimary}"
                                                                       FontSize="10" FontAttributes="Bold"
                                                                       MaxLines="2" LineBreakMode="WordWrap"/>
                                                                <Label Text="{Binding LotSizeDisplay}"
                                                                       TextColor="{StaticResource TextMuted}" FontSize="8"/>
                                                            </VerticalStackLayout>
                                                        </Grid>

                                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                                                             Margin="4,10,4,10" Spacing="5" VerticalOptions="Start">
                                                            <Border BackgroundColor="{StaticResource AccentGreenBg}"
                                                                    Stroke="{StaticResource AccentGreenBorder}"
                                                                    StrokeThickness="1" Padding="6,6">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding BestBidDisplay}"
                                                                       TextColor="{StaticResource AccentGreen}"
                                                                       FontSize="13" FontAttributes="Bold"
                                                                       HorizontalTextAlignment="Center"/>
                                                            </Border>
                                                            <Label Text="{Binding NextBid1, StringFormat='{0:N0}'}"
                                                                   TextColor="{StaticResource AccentGreenDim}" FontSize="10"
                                                                   IsVisible="{Binding NextBid1, Converter={StaticResource NotZeroConverter}}"
                                                                   HorizontalTextAlignment="Center"/>
                                                            <Label Text="{Binding NextBid2, StringFormat='{0:N0}'}"
                                                                   TextColor="{StaticResource AccentGreenFaint}" FontSize="10"
                                                                   IsVisible="{Binding NextBid2, Converter={StaticResource NotZeroConverter}}"
                                                                   HorizontalTextAlignment="Center"/>
                                                        </VerticalStackLayout>

                                                        <VerticalStackLayout Grid.Row="1" Grid.Column="2"
                                                                             Margin="4,10,10,10" Spacing="5" VerticalOptions="Start">
                                                            <Border BackgroundColor="{StaticResource AccentRedBg}"
                                                                    Stroke="{StaticResource AccentRedBorder}"
                                                                    StrokeThickness="1" Padding="6,6">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="6"/>
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding BestOfferDisplay}"
                                                                       TextColor="{StaticResource AccentRed}"
                                                                       FontSize="13" FontAttributes="Bold"
                                                                       HorizontalTextAlignment="Center"/>
                                                            </Border>
                                                            <Label Text="{Binding NextOffer1, StringFormat='{0:N0}'}"
                                                                   TextColor="{StaticResource AccentRedDim}" FontSize="10"
                                                                   IsVisible="{Binding NextOffer1, Converter={StaticResource NotZeroConverter}}"
                                                                   HorizontalTextAlignment="Center"/>
                                                            <Label Text="{Binding NextOffer2, StringFormat='{0:N0}'}"
                                                                   TextColor="{StaticResource AccentRedFaint}" FontSize="10"
                                                                   IsVisible="{Binding NextOffer2, Converter={StaticResource NotZeroConverter}}"
                                                                   HorizontalTextAlignment="Center"/>
                                                        </VerticalStackLayout>

                                                        <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                                 HeightRequest="0.5" Color="{StaticResource BgChip}"/>
                                                        <Label Grid.Row="2" Grid.Column="0"
                                                               Text="REGION" TextColor="{StaticResource TextMuted}"
                                                               FontSize="7" FontAttributes="Bold" CharacterSpacing="1"
                                                               Margin="10,6,0,7" VerticalOptions="Center"/>
                                                        <Label Grid.Row="2" Grid.Column="1"
                                                               Text="{Binding BestBidLocation}"
                                                               TextColor="{StaticResource AccentGreenFaint}"
                                                               FontSize="8" Margin="4,6,4,7" VerticalOptions="Center"/>
                                                        <Label Grid.Row="2" Grid.Column="2"
                                                               Text="{Binding BestOfferLocation}"
                                                               TextColor="{StaticResource AccentRedFaint}"
                                                               FontSize="8" Margin="4,6,10,7" VerticalOptions="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </dxcv:DXCollectionView.ItemTemplate>
            </dxcv:DXCollectionView>

        </Grid>
        <!-- ══ END SEARCH OVERLAY ══ -->

    </Grid>
</ContentPage>