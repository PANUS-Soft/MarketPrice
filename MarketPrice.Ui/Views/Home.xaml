<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MarketPrice.Ui.Views.Home"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" 
                             Spacing="0" 
                             BackgroundColor="White">

            <Grid ColumnDefinitions="Auto, *" 
                  Padding="15,10">

                <HorizontalStackLayout Grid.Column="0" 
                                       Spacing="12" 
                                       VerticalOptions="Center">
                    <Label Text="MarketPrice"
                           TextColor="{StaticResource PrimaryBase}"
                           FontSize="20"
                           FontFamily="RobotoSerifMedium"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label Grid.Column="1" 
                       Text="⋮" 
                       FontSize="28" 
                       TextColor="Black" 
                       VerticalOptions="Center" 
                       HorizontalOptions="End"/>
            </Grid>

            <BoxView HeightRequest="1" 
                     Color="#F0F0F0" 
                     VerticalOptions="End"/>
        </VerticalStackLayout>


        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Commodities}"
                        SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="35" 
                                     Padding="20">

                    <!--<Border Stroke="#2F80ED" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 10" 
                            HeightRequest="50" 
                            BackgroundColor="White" 
                            Padding="15,0">

                        <Grid ColumnDefinitions="30, *, 30">
                            <Label Grid.Column="0" 
                                   Text="🔍" 
                                   FontSize="18" 
                                   TextColor="Gray" 
                                   VerticalOptions="Center"/>

                            <dxe:TextEdit Grid.Column="1" 
                                          PlaceholderText="Search" 
                                          TextFontFamily="RobotoSerifRegular"
                                          TextColor="Black" 
                                          BoxMode="Filled"
                                          BackgroundColor="Transparent"
                                          VerticalOptions="Start"/>
                        </Grid>
                    </Border>-->

                    <Border Stroke="#E5E5E5"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Background}"
                            Padding="0,10">

                        <Border StrokeShape="RoundRectangle 15"
                                Stroke="{StaticResource PrimaryBase}"
                                StrokeThickness="3"
                                BackgroundColor="#F9F9F9">
                            <SearchBar Placeholder="Search"/>
                        </Border>
                    </Border>

                    <Grid ColumnDefinitions="*, Auto" 
                          ColumnSpacing="10">

                        <Label Grid.Column="0" 
                               Text="Complete Your&#10;Verification" 
                               FontSize="20" 
                               FontFamily="RobotoSerifSemibold"
                               TextColor="{StaticResource TextPrimary}"
                               LineHeight="1.2"
                               VerticalOptions="Center"/>

                        <Button Grid.Column="1" 
                                Text="Verify"
                                TextColor="{StaticResource TextPrimary}"
                                FontSize="15"
                                FontFamily="RobotoSerifSemibold"
                                BackgroundColor="White" 
                                BorderColor="{StaticResource PrimaryBase}" 
                                BorderWidth="3" 
                                CornerRadius="10" 
                                HeightRequest="40" 
                                Padding="35,0"
                                VerticalOptions="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="50, *, 100, 100" 
                          ColumnSpacing="5">

                        <Label Grid.Column="0" 
                               Text="Commodities"
                               FontFamily="RobotoSerifSemibold"
                               Grid.ColumnSpan="2"
                               FontSize="15" 
                               FontAttributes="Bold" 
                               TextColor="Black" 
                               VerticalOptions="End"/>

                        <Label Grid.Column="2" 
                               Text="BEST BID" 
                               FontFamily="RobotoSerifSemibold"
                               FontSize="15" 
                               FontAttributes="Bold" 
                               TextColor="Black" 
                               HorizontalOptions="Center"/>

                        <Label Grid.Column="3" 
                               Text="BEST OFFER" 
                               FontFamily="RobotoSerifSemibold"
                               FontSize="15" 
                               FontAttributes="Bold" 
                               TextColor="Black" 
                               HorizontalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="50, *, 100, 100" 
                          ColumnSpacing="5"
                          Padding="20,0,20,20">

                        <Frame Grid.Column="0" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               CornerRadius="25" 
                               IsClippedToBounds="True" 
                               Padding="0" 
                               BorderColor="Transparent" 
                               VerticalOptions="Center">

                            <Image Source="{Binding ImageSource}" 
                                   Aspect="AspectFill" 
                                   BackgroundColor="{Binding BackgroundColor}"/>
                        </Frame>

                        <VerticalStackLayout Grid.Column="1" 
                                             VerticalOptions="Center" 
                                             Spacing="0">
                            <Label Text="{Binding Name}"
                                   FontFamily="RobotoSerifBold"
                                   FontSize="16"
                                   TextColor="{StaticResource TextPrimary}"/>

                            <Label Text="{Binding LotSize}"
                                   FontFamily="RobotoSerifRegular"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="2" 
                                Stroke="{StaticResource PrimaryBase}" 
                                StrokeShape="RoundRectangle 5"
                                StrokeThickness="2" 
                                HeightRequest="35"
                                Padding="10,0">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=NavigateToPlaceBidCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding BestBidPrice}" 
                                       FontSize="10"
                                       FontFamily="RobotoSerifRegular"
                                       TextColor="{StaticResource TextSecondary}" 
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="▲" 
                                       FontSize="12" 
                                       TextColor="#27AE60" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsBidTrendUp}"/>
                                <Label Grid.Column="1" 
                                       Text="▼" 
                                       FontSize="12" 
                                       TextColor="#EB5757" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsOfferTrendUp, Converter={StaticResource InvertedBoolConverter}}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" 
                                Stroke="{StaticResource PrimaryBase}"
                                StrokeShape="RoundRectangle 5"
                                StrokeThickness="2" 
                                HeightRequest="35" 
                                Padding="10,0">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=NavigateToPlaceOfferCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding BestOfferPrice}" 
                                       FontSize="10" 
                                       FontFamily="RobotoSerifRegular"
                                       TextColor="{StaticResource TextSecondary}" 
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="▲" 
                                       FontSize="12" 
                                       TextColor="#27AE60" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsBidTrendUp}"/>
                                <Label Grid.Column="1" 
                                       Text="▼" 
                                       FontSize="12" 
                                       TextColor="#EB5757" 
                                       VerticalOptions="Center"
                                       IsVisible="{Binding IsOfferTrendUp, Converter={StaticResource InvertedBoolConverter}}"/>
                            </Grid>
                        </Border>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>