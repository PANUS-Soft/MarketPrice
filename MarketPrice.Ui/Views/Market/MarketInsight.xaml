<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Charts;assembly=DevExpress.Maui.Charts"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             xmlns:models="clr-namespace:MarketPrice.Ui.Models"
             xmlns:converters="clr-namespace:MarketPrice.Ui.Converters"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:dto="clr-namespace:MarketPrice.Domain.Market.DTOs;assembly=MarketPrice.Domain"
             x:DataType="viewModels:MarketInsightViewModel"
             x:Class="MarketPrice.Ui.Views.MarketInsight"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False"
             Title="MarketInsight">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="0" Padding="0">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,10" BackgroundColor="Transparent">
            <ImageButton Grid.Column="0" 
                         Source="back.png" 
                         HeightRequest="24" 
                         WidthRequest="24" 
                         VerticalOptions="Center" 
                         Command="{Binding BackCommand}" 
                         BackgroundColor="Transparent"/>

            <HorizontalStackLayout Grid.Column="1"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="7"
                                   Padding="8,0">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowCommoditySelectorCommand}"/>
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="{Binding CommodityName}"
                       FontAttributes="Bold" 
                    FontSize="20"
                       TextColor="White"
                       FontFamily="RobotoSerifBold"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       MaximumWidthRequest="220"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>
                <Image Source="dropdown_icon.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       Aspect="AspectFit"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <ImageButton Grid.Column="2" 
                         Source="favourite_icon.png" 
                         HeightRequest="30" 
                         WidthRequest="30" 
                         BackgroundColor="Transparent" 
                         VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1" IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="20" Padding="15">

                <Border Grid.Row="0" 
                        Stroke="#334155" 
                        StrokeThickness="1" 
                        BackgroundColor="#1E293B" 
                        StrokeShape="RoundRectangle 12" 
                        Padding="15,10">
                    <Grid ColumnDefinitions="Auto, *, *, Auto" ColumnSpacing="5">

                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Max(24h)" FontSize="10" TextColor="#94A3B8" FontFamily="RobotoSerifRegular"/>
                            <Label Text="{Binding MaxBid24H, StringFormat='CFA {0:N0}'}" FontSize="11" TextColor="White" FontFamily="RobotoSerifBold"/>
                            <Label Text="Min(24h)" FontSize="10" TextColor="#94A3B8" FontFamily="RobotoSerifRegular" Margin="0,8,0,0"/>
                            <Label Text="{Binding MinBid24H, StringFormat='CFA {0:N0}'}" FontSize="11" TextColor="White" FontFamily="RobotoSerifBold"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                            <Label Text="Bid" FontSize="14" TextColor="White" HorizontalOptions="Center" FontFamily="RobotoSerifMedium"/>
                            <Border Stroke="White" StrokeThickness="1" BackgroundColor="Transparent" Padding="15,4" StrokeShape="RoundRectangle 4">
                                <Label Text="{Binding BestBid, StringFormat='{0:N0}'}" FontSize="16" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Border>
                            <Label Text="{Binding BidCount}" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                            <Label Text="Offer" FontSize="14" TextColor="White" HorizontalOptions="Center" FontFamily="RobotoSerifMedium"/>
                            <Border Stroke="White" StrokeThickness="1" BackgroundColor="Transparent" Padding="15,4" StrokeShape="RoundRectangle 4">
                                <Label Text="{Binding BestOffer, StringFormat='{0:N0}'}" FontSize="16" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Border>
                            <Label Text="{Binding OfferCount}" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                            <Label Text="Max(24h)" FontSize="10" TextColor="#94A3B8" HorizontalOptions="End" FontFamily="RobotoSerifRegular"/>
                            <Label Text="{Binding MaxOffer24H, StringFormat='CFA {0:N0}'}" FontSize="11" TextColor="White" HorizontalOptions="End" FontFamily="RobotoSerifBold"/>
                            <Label Text="Min(24h)" FontSize="10" TextColor="#94A3B8" HorizontalOptions="End" FontFamily="RobotoSerifRegular" Margin="0,8,0,0"/>
                            <Label Text="{Binding MinOffer24H, StringFormat='CFA {0:N0}'}" FontSize="11" TextColor="White" HorizontalOptions="End" FontFamily="RobotoSerifBold"/>
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <dxc:ChartView Grid.Row="1" HeightRequest="280" BackgroundColor="Transparent">
                    <dxc:ChartView.Hint>
                        <dxc:Hint ShowMode="OnTap">
                            <dxc:Hint.Style>
                                <dxc:HintStyle BackgroundColor="#1E293B"/>
                            </dxc:Hint.Style>
                        </dxc:Hint>
                    </dxc:ChartView.Hint>

                    <dxc:ChartView.Series>
                        <dxc:LineSeries MarkersVisible="True" DisplayName="Bid">
                            <dxc:LineSeries.Data>
                                <dxc:SeriesDataAdapter DataSource="{Binding PriceHistory}" ArgumentDataMember="Timestamp">
                                    <dxc:ValueDataMember Type="Value" Member="AvgBid"/>
                                </dxc:SeriesDataAdapter>
                            </dxc:LineSeries.Data>
                            <dxc:LineSeries.Style>
                                <dxc:LineSeriesStyle Stroke="#22C55E" StrokeThickness="2">
                                    <dxc:LineSeriesStyle.MarkerStyle>
                                        <dxc:MarkerStyle Fill="#22C55E"/>
                                    </dxc:LineSeriesStyle.MarkerStyle>
                                </dxc:LineSeriesStyle>
                            </dxc:LineSeries.Style>
                        </dxc:LineSeries>

                        <dxc:LineSeries MarkersVisible="True" DisplayName="Offer">
                            <dxc:LineSeries.Data>
                                <dxc:SeriesDataAdapter DataSource="{Binding PriceHistory}" ArgumentDataMember="Timestamp">
                                    <dxc:ValueDataMember Type="Value" Member="AvgOffer"/>
                                </dxc:SeriesDataAdapter>
                            </dxc:LineSeries.Data>
                            <dxc:LineSeries.Style>
                                <dxc:LineSeriesStyle Stroke="#3B82F6" StrokeThickness="2">
                                    <dxc:LineSeriesStyle.MarkerStyle>
                                        <dxc:MarkerStyle Fill="#3B82F6"/>
                                    </dxc:LineSeriesStyle.MarkerStyle>
                                </dxc:LineSeriesStyle>
                            </dxc:LineSeries.Style>
                        </dxc:LineSeries>
                    </dxc:ChartView.Series>

                    <dxc:ChartView.AxisX>
                        <dxc:DateTimeAxisX Visible="True">
                            <dxc:DateTimeAxisX.Label>
                                <dxc:AxisLabel TextFormat="dd MMM"/>
                            </dxc:DateTimeAxisX.Label>
                            <dxc:DateTimeAxisX.Style>
                                <dxc:AxisStyle LineColor="#334155" LineThickness="1"/>
                            </dxc:DateTimeAxisX.Style>
                        </dxc:DateTimeAxisX>
                    </dxc:ChartView.AxisX>

                    <dxc:ChartView.AxisY>
                        <dxc:NumericAxisY AlwaysShowZeroLevel="False">
                            <dxc:NumericAxisY.Label>
                                <dxc:AxisLabel TextFormat="'N'0"/>
                            </dxc:NumericAxisY.Label>
                            <dxc:NumericAxisY.Style>
                                <dxc:AxisStyle LineVisible="False" MajorGridlinesVisible="True" MajorGridlinesColor="#334155"/>
                            </dxc:NumericAxisY.Style>
                        </dxc:NumericAxisY>
                    </dxc:ChartView.AxisY>

                    <dxc:ChartView.Legend>
                        <dxc:Legend VerticalPosition="Top" HorizontalPosition="Center" Orientation="LeftToRight"/>
                    </dxc:ChartView.Legend>
                </dxc:ChartView>

                <VerticalStackLayout Grid.Row="2" Spacing="15" Margin="0,10,0,0">

                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,*">
                            <Label Grid.Column="0" Text="{Binding BidPercentage, StringFormat='{0:F0}%'}" FontSize="12" TextColor="#22C55E" FontFamily="RobotoSerifMedium"/>
                            <Label Grid.Column="1" Text="{Binding OfferPercentage, StringFormat='{0:F0}%'}" FontSize="12" TextColor="#3B82F6" HorizontalOptions="End" FontFamily="RobotoSerifMedium"/>
                        </Grid>

                        <Grid HeightRequest="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding BidWidth}"/>
                                <ColumnDefinition Width="{Binding OfferWidth}"/>
                            </Grid.ColumnDefinitions>

                            <BoxView Grid.Column="0" Color="#22C55E"/>
                            <BoxView Grid.Column="1" Color="#3B82F6"/>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="25*, 25*, 25*, 25*" Padding="0,5">
                        <Label Grid.Column="0" Text="Bidders" FontSize="13" TextColor="White" FontFamily="RobotoSerifBold"/>
                        <Label Grid.Column="1" Text="Amount" FontSize="13" TextColor="White" FontFamily="RobotoSerifBold"/>
                        <Label Grid.Column="2" Text="Offerors" FontSize="13" TextColor="White" FontFamily="RobotoSerifBold" HorizontalOptions="Center"/>
                        <Label Grid.Column="3" Text="Amount" FontSize="13" TextColor="White" FontFamily="RobotoSerifBold" HorizontalOptions="End"/>
                    </Grid>

                    <Grid ColumnDefinitions="50*, 50*">
                        <CollectionView Grid.Column="0" ItemsSource="{Binding Bids}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:MarketDepthItemDto">
                                    <Grid ColumnDefinitions="50*, 50*">
                                        <Label Grid.Column="0" Text="{Binding PositionCount}" TextColor="#22C55E" FontSize="12" Margin="0,5"/>
                                        <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:N0}'}" TextColor="#22C55E" FontSize="12" Margin="0,5">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketInsightViewModel}}, Path=NavigateToBidPositionListingCommand}" 
                        CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <CollectionView Grid.Column="1" ItemsSource="{Binding Offers}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="dto:MarketDepthItemDto">
                                    <Grid ColumnDefinitions="50*, 50*">
                                        <Label Grid.Column="0" Text="{Binding PositionCount}" TextColor="#3B82F6" FontSize="12" HorizontalOptions="Center" Margin="0,5"/>
                                        <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:N0}'}" TextColor="#3B82F6" FontSize="12" HorizontalOptions="End" Margin="0,5">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketInsightViewModel}}, Path=NavigateToOfferPositionListingCommand}" 
                                                CommandParameter="{Binding .}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Static skeletons keep the layout stable while both insight requests complete. -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsLoading}">
            <VerticalStackLayout Padding="15" Spacing="20">
                <Border HeightRequest="115" BackgroundColor="#26354B" StrokeThickness="0" StrokeShape="RoundRectangle 12"/>
                <Border HeightRequest="280" BackgroundColor="#26354B" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="{StaticResource PrimaryBase}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border HeightRequest="28" BackgroundColor="#26354B" StrokeThickness="0" StrokeShape="RoundRectangle 8"/>
                    <Border Grid.Column="1" HeightRequest="28" BackgroundColor="#26354B" StrokeThickness="0" StrokeShape="RoundRectangle 8"/>
                </Grid>
                <Border HeightRequest="145" BackgroundColor="#26354B" StrokeThickness="0" StrokeShape="RoundRectangle 12"/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" Padding="15" ColumnSpacing="10" BackgroundColor="{StaticResource Background}">
            <Button Grid.Column="0" FontFamily="RobotoSerifBold" Text="Place a Bid" BackgroundColor="{StaticResource PrimaryBase}" TextColor="White" CornerRadius="10" Command="{Binding NavigateToPlaceBidCommand}"/>
            <Button Grid.Column="1" FontFamily="RobotoSerifBold" Text="Place an Offer" BackgroundColor="White" BorderColor="{StaticResource PrimaryBase}" BorderWidth="3" TextColor="{StaticResource PrimaryBase}" CornerRadius="10" Command="{Binding NavigateToPlaceOfferCommand}"/>
        </Grid>

        <dx:BottomSheet Grid.RowSpan="3"
                        State="{Binding CommodityBottomSheetState, Mode=TwoWay}"
                        HalfExpandedRatio="0.55"
                        ShowGrabber="True"
                        GrabberColor="White"
                        BackgroundColor="#172033">
            <Grid RowDefinitions="Auto,*" Padding="20,10,20,25" RowSpacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Switch commodity"
                           TextColor="White"
                           FontFamily="RobotoSerifBold"
                           FontSize="20"
                           HorizontalOptions="Center"/>
                    <Label Text="Select a commodity to view its insights"
                           TextColor="#94A3B8"
                           FontFamily="RobotoSerifRegular"
                           FontSize="12"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Commodities}"
                                SelectedItem="{Binding SelectedCommodity, Mode=TwoWay}"
                                SelectionMode="Single"
                                VerticalOptions="Fill"
                                VerticalScrollBarVisibility="Always"
                                ItemsUpdatingScrollMode="KeepScrollOffset">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MarketItemFilter">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="8,11"
                                  BackgroundColor="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                                <Setter TargetName="RadioOutline" Property="Border.Stroke" Value="#3B82F6"/>
                                                <Setter TargetName="RadioDot" Property="shapes:Ellipse.Opacity" Value="1"/>
                                                <Setter TargetName="CommodityLabel" Property="Label.TextColor" Value="White"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="RadioOutline"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        Stroke="#94A3B8"
                                        StrokeThickness="2"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="4"
                                        VerticalOptions="Center">
                                    <shapes:Ellipse x:Name="RadioDot"
                                                    Fill="#3B82F6"
                                                    Opacity="0"/>
                                </Border>

                                <Label x:Name="CommodityLabel"
                                       Grid.Column="1"
                                       Text="{Binding Name}"
                                       TextColor="White"
                                       FontFamily="RobotoSerifRegular"
                                       FontSize="17"
                                       VerticalTextAlignment="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </dx:BottomSheet>
    </Grid>

</ContentPage>
