<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MarketPrice.Ui.Converters"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             x:Class="MarketPrice.Ui.Views.Market"
             Title="Market">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>

            <converters:AllTrueToVisibleConverter x:Key="AllTrueToVisibleConverter"/>

            <ControlTemplate x:Key="MarketItemSkeleton">
                <Grid ColumnDefinitions="Auto, 2*, 1.5*, 1.5*" Padding="0,10" ColumnSpacing="10">
                    <BoxView Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#F0F0F0"/>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                        <BoxView WidthRequest="80" HeightRequest="12" CornerRadius="4" BackgroundColor="#F0F0F0" HorizontalOptions="Start"/>
                        <BoxView WidthRequest="50" HeightRequest="10" CornerRadius="4" BackgroundColor="#F5F5F5" HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" RowSpacing="0">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="15,10" ColumnSpacing="15">
                <Border Grid.Row="0" StrokeShape="RoundRectangle 15" Stroke="{StaticResource PrimaryBase}" StrokeThickness="3" BackgroundColor="White">
                    <SearchBar Placeholder="Search" Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}" BackgroundColor="Transparent" CancelButtonColor="{StaticResource PrimaryBase}" VerticalOptions="Center"/>
                </Border>
                <Image Grid.Column="1" Source="bell_icon.png" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" HorizontalOptions="End"/>
            </Grid>

            <Grid Grid.Row="1" Padding="15,0">
                <dxcv:DXCollectionView ItemsSource="{Binding CommodityTypesList}" SelectedItem="{Binding SelectedCommodityType, Mode=TwoWay}" SelectionMode="Single" Orientation="Horizontal" HeightRequest="50">
                    <dxcv:DXCollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalOptions="Fill" Margin="0,0,20,0" Padding="0,5">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label x:Name="commodityTypeLabel" Text="{Binding .}" FontFamily="RobotoSerifBold" VerticalTextAlignment="Center"
                           TextColor="{StaticResource Black}" HorizontalOptions="Center"/>

                                    <BoxView x:Name="underline" HeightRequest="3" BackgroundColor="{StaticResource PrimaryBase}" HorizontalOptions="Fill" IsVisible="False"/>
                                </VerticalStackLayout>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal"/>
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter TargetName="commodityTypeLabel" Property="Label.TextColor" Value="{StaticResource PrimaryBase}"/>
                                                <Setter TargetName="underline" Property="BoxView.IsVisible" Value="True"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </DataTemplate>
                    </dxcv:DXCollectionView.ItemTemplate>
                </dxcv:DXCollectionView>
                <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource PriceBoxBorder}" VerticalOptions="End"/>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="Auto, 2*, 1.5*, 1.5*" Padding="15,10" ColumnSpacing="10">

                <BoxView Grid.Column="0" WidthRequest="40" BackgroundColor="White"/>
                <Label Grid.Column="1" Text="Commodities" FontFamily="RobotoSerifBold" Style="{StaticResource HeaderLabelStyle}" HorizontalOptions="Start"/>
                <Label Grid.Column="2" Text="BEST BID &#10; (FCFA)" FontFamily="RobotoSerifBold" Style="{StaticResource HeaderLabelStyle}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Label Grid.Column="3" Text="BEST OFFER  (FCFA)" FontFamily="RobotoSerifBold" Style="{StaticResource HeaderLabelStyle}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="3" Padding="15,0">
                <dxcv:DXCollectionView ItemsSource="{Binding MarketItems}" SelectionMode="None">
                    <dxcv:DXCollectionView.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibleConverter}">
                            <Binding Path="IsLoading" Converter="{StaticResource InvertedBoolConverter}"/>
                            <Binding Path="IsListEmpty" Converter="{StaticResource InvertedBoolConverter}"/>
                        </MultiBinding>
                    </dxcv:DXCollectionView.IsVisible>
                    
                    <dxcv:DXCollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto, 2*, 1.5*, 1.5*" Padding="0,10" ColumnSpacing="10">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToCommodityInsightCommand}"
                                    CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>

                                <Border Grid.Column="0" StrokeShape="Ellipse"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        StrokeThickness="0">
                                    <Image Source="{Binding ImageSource}" Aspect="AspectFill">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}},Path=OpenImagePreviewCommand}"
                                            CommandParameter="{Binding .}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" FontFamily="RobotoSerifMedium" FontSize="14" TextColor="Black"/>
                                    <Label Text="{Binding LotSizeDisplay}" TextColor="Gray" FontSize="12"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="2" 
                                        Text="{Binding BestBid}" 
                                        FontSize="12" 
                                        FontFamily="RobotoSerifRegular" 
                                        IsVisible="{Binding IsBidUp}" 
                                        BackgroundColor="#369F79"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToBidPositionListingCommand}"
                                        CommandParameter="{Binding .}"/>
                                
                                <Button Grid.Column="2" 
                                        Text="{Binding BestBid}" 
                                        FontSize="12" 
                                        FontFamily="RobotoSerifRegular" 
                                        IsVisible="{Binding IsBidDown}" 
                                        BackgroundColor="#E84235"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToBidPositionListingCommand}"
                                        CommandParameter="{Binding .}"/>
                                
                                <Button Grid.Column="2" 
                                        BorderWidth="3" 
                                        BorderColor="{StaticResource PrimaryBase}" 
                                        BackgroundColor="White" 
                                        Text="{Binding BestBid}" 
                                        TextColor="{StaticResource PrimaryBase}" 
                                        FontSize="12" 
                                        FontFamily="RobotoSerifRegular" 
                                        IsVisible="{Binding IsBidNull}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToBidPositionListingCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Grid.Column="3" 
                                        Text="{Binding BestOffer}" 
                                        FontSize="12" 
                                        FontFamily="RobotoSerifRegular" 
                                        IsVisible="{Binding IsOfferUp}" 
                                        BackgroundColor="#369F79"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToOfferPositionListingCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Grid.Column="3" 
                                        Text="{Binding BestOffer}" 
                                        FontSize="12"
                                        FontFamily="RobotoSerifRegular"
                                        IsVisible="{Binding IsOfferDown}" 
                                        BackgroundColor="#E84235"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToOfferPositionListingCommand}"
                                        CommandParameter="{Binding .}"/>

                                <Button Grid.Column="3" 
                                        BorderWidth="3" 
                                        BorderColor="{StaticResource PrimaryBase}" 
                                        BackgroundColor="White" 
                                        Text="{Binding BestOffer}" 
                                        TextColor="{StaticResource PrimaryBase}" 
                                        FontSize="12" 
                                        FontFamily="RobotoSerifRegular" 
                                        IsVisible="{Binding IsOfferNull}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToOfferPositionListingCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </DataTemplate>
                    </dxcv:DXCollectionView.ItemTemplate>
                </dxcv:DXCollectionView>

                <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="5" VerticalOptions="Start">
                    <VerticalStackLayout>
                        <BindableLayout.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>1</x:String>
                                <x:String>2</x:String>
                                <x:String>3</x:String>
                                <x:String>4</x:String>
                                <x:String>5</x:String>
                                <x:String>6</x:String>
                                <x:String>7</x:String>
                                <x:String>8</x:String>
                                <x:String>9</x:String>
                                <x:String>10</x:String>
                            </x:Array>
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, 2*, 1.5*, 1.5*" Padding="0,10" ColumnSpacing="10" Opacity="0.5">
                                    <BoxView Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#E0E0E0"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <BoxView WidthRequest="100" HeightRequest="12" CornerRadius="4" BackgroundColor="#E0E0E0" HorizontalOptions="Start"/>
                                        <BoxView WidthRequest="60" HeightRequest="10" CornerRadius="4" BackgroundColor="#F0F0F0" HorizontalOptions="Start"/>
                                    </VerticalStackLayout>
                                    <BoxView Grid.Column="2" HeightRequest="35" CornerRadius="8" BackgroundColor="#E0E0E0"/>
                                    <BoxView Grid.Column="3" HeightRequest="35" CornerRadius="8" BackgroundColor="#E0E0E0"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <VerticalStackLayout.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibleConverter}">
                            <Binding Path="Isloading" Converter="{StaticResource InvertedBoolConverter}"/>
                            <Binding Path="IsListEmpty" Converter="{StaticResource InvertedBoolConverter}"/>
                        </MultiBinding>
                    </VerticalStackLayout.IsVisible>
                    <Image Source="no_result_icon.png" HeightRequest="80" Opacity="0.5"/>
                    <Label Text="No commodities found" FontSize="16" FontFamily="RobotoSerifMedium" HorizontalOptions="Center"/>
                    <Label Text="Try adjusting your search or commodity type" FontSize="13" FontFamily="RobotoSerifRegular" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
        <Grid IsVisible="{Binding IsImagePreviewVisible}"
              BackgroundColor="#80000000"
              ZIndex="100"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseImagePreviewCommand}"/>
            </Grid.GestureRecognizers>

            <Border StrokeShape="RoundRectangle 20"
                    Padding="0"
                    StrokeThickness="1"
                    Stroke="Gray"
                    BackgroundColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="30">

                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0, 10" Radius="20" Opacity="0.6" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*, Auto"
                          Padding="15, 10">
                        <Label Text="{Binding SelectedCommodityTypeName}"
                               FontSize="15"
                               FontFamily="RobotoSerifBold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"/>

                        <Button Grid.Column="1"
                                Text="✕"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="{StaticResource PrimaryBase}"
                                CornerRadius="15"
                                HeightRequest="30"
                                WidthRequest="30"
                                Padding="0"
                                Command="{Binding CloseImagePreviewCommand}"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="Gray" />
                    <Image Source="{Binding PreviewImage}"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <BoxView HeightRequest="1" Color="#EEEEEE" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>