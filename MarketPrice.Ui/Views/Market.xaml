<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MarketPrice.Ui.Converters"
    xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
    xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
    xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
    xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
    x:Class="MarketPrice.Ui.Views.Market"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource Background}"
    Title="Market">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid 
            RowDefinitions="Auto, Auto, Auto, *, Auto" 
            RowSpacing="0" 
            Padding="15,15,15,0">

            <!-- 1. HEADER: Search & Notification -->
            <Grid 
                Grid.Row="0" 
                ColumnDefinitions="*, Auto" 
                Padding="0,0,0,15" 
                ColumnSpacing="15">

                <Border 
                    Grid.Column="0" 
                    StrokeShape="RoundRectangle 20" 
                    BackgroundColor="#2A2A2A" 
                    StrokeThickness="0" 
                    HeightRequest="45">

                    <SearchBar 
                        Placeholder="Search" 
                        Text="{Binding SearchText}" 
                        SearchCommand="{Binding SearchCommand}" 
                        BackgroundColor="Transparent" 
                        TextColor="White"
                        PlaceholderColor="#888888"
                        CancelButtonColor="White" 
                        VerticalOptions="Center"/>
                </Border>

                <ImageButton 
                    Grid.Column="1" 
                    Source="bell_icon.png" 
                    HeightRequest="24" 
                    WidthRequest="24" 
                    VerticalOptions="Center" 
                    HorizontalOptions="End"/>
            </Grid>

            <!-- 2. CATEGORY TABS -->
            <Grid 
                Grid.Row="1" 
                Padding="0,0,0,10">

                <dxcv:DXCollectionView 
                    ItemsSource="{Binding CommodityTypesList}" 
                    SelectedItem="{Binding SelectedCommodityType, Mode=TwoWay}" 
                    SelectionMode="Single" 
                    Orientation="Horizontal" 
                    HeightRequest="40">

                    <dxcv:DXCollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid 
                                VerticalOptions="Fill" 
                                Margin="0,0,25,0" 
                                Padding="0,5">

                                <VerticalStackLayout 
                                    VerticalOptions="Center" 
                                    Spacing="5">

                                    <Label 
                                        x:Name="commodityTypeLabel" 
                                        Text="{Binding .}" 
                                        FontFamily="RobotoSerifBold" 
                                        FontSize="14" 
                                        VerticalTextAlignment="Center" 
                                        TextColor="#CCCCCC" 
                                        HorizontalOptions="Center"/>

                                    <BoxView 
                                        x:Name="underline" 
                                        HeightRequest="2" 
                                        BackgroundColor="White" 
                                        HorizontalOptions="Fill" 
                                        IsVisible="False"/>
                                </VerticalStackLayout>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal"/>
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter TargetName="commodityTypeLabel" Property="Label.TextColor" Value="White"/>
                                                <Setter TargetName="underline" Property="BoxView.IsVisible" Value="True"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </DataTemplate>
                    </dxcv:DXCollectionView.ItemTemplate>
                </dxcv:DXCollectionView>

                <BoxView 
                    Grid.Row="1" 
                    HeightRequest="1" 
                    Color="#333333" 
                    VerticalOptions="End" 
                    Margin="-15,0,-15,0"/>
            </Grid>

            <!-- 3. BID / OFFER TOGGLE -->
            <HorizontalStackLayout 
                Grid.Row="2" 
                HorizontalOptions="End" 
                Spacing="10" 
                Margin="0,15,0,20">

                <!-- Bid Button -->
                <Border 
                    Stroke="White" 
                    StrokeThickness="1" 
                    BackgroundColor="Transparent" 
                    StrokeShape="RoundRectangle 8" 
                    Padding="20,5">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                            Command="{Binding SetSideCommand}" 
                            CommandParameter="Bid"/>
                    </Border.GestureRecognizers>

                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsBidHighlighted}" Value="True">
                            <Setter Property="BackgroundColor" Value="White" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Label 
                        Text="Bid" 
                        TextColor="White" 
                        FontFamily="RobotoSerifBold" 
                        FontSize="14" 
                        HorizontalOptions="Center">

                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsBidHighlighted}" Value="True">
                                <Setter Property="TextColor" Value="Black" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>

                <!-- Offer Button -->
                <Border 
                    Stroke="White" 
                    StrokeThickness="1" 
                    BackgroundColor="Transparent" 
                    StrokeShape="RoundRectangle 8" 
                    Padding="20,5">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer 
                            Command="{Binding SetSideCommand}" 
                            CommandParameter="Offer"/>
                    </Border.GestureRecognizers>

                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOfferHighlighted}" Value="True">
                            <Setter Property="BackgroundColor" Value="White" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Label 
                        Text="Offer" 
                        TextColor="White" 
                        FontFamily="RobotoSerifBold" 
                        FontSize="14" 
                        HorizontalOptions="Center">

                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOfferHighlighted}" Value="True">
                                <Setter Property="TextColor" Value="Black" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </HorizontalStackLayout>

            <!-- 4. COMMODITY LIST CARDS -->
            <Grid 
                Grid.Row="3" 
                Padding="0,0">

                <CollectionView 
                    ItemsSource="{Binding MarketItems}" 
                    SelectionMode="None" 
                    IsVisible="{Binding IsListEmpty, Converter={StaticResource InvertedBoolConverter}}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border 
                                Stroke="White" 
                                StrokeThickness="1" 
                                BackgroundColor="#1A1A1A" 
                                StrokeShape="RoundRectangle 10"
                                Margin="0,0,0,15"
                                Padding="15,10">

                                <Grid 
                                    ColumnDefinitions="50, *, Auto, 75" 
                                    ColumnSpacing="15" 
                                    VerticalOptions="Center">

                                    <!-- 1. MAIN CARD GESTURE (Goes to Market Detail) -->
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToMarketDetailCommand}" 
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>

                                    <!-- Commodity Image -->
                                    <Border 
                                        Grid.Column="0" 
                                        HeightRequest="50" 
                                        WidthRequest="50" 
                                        StrokeShape="RoundRectangle 25" 
                                        StrokeThickness="0" 
                                        BackgroundColor="#333333">

                                        <Image 
                                            Source="{Binding ImageSource}" 
                                            Aspect="AspectFill">

                                            <!-- Image Preview Gesture -->
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=OpenImagePreviewCommand}" 
                                                    CommandParameter="{Binding .}"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Border>

                                    <!-- Name & Lot Size -->
                                    <VerticalStackLayout 
                                        Grid.Column="1" 
                                        VerticalOptions="Center" 
                                        Spacing="2">

                                        <Label 
                                            Text="{Binding Name}" 
                                            TextColor="White" 
                                            FontFamily="RobotoSerifMedium" 
                                            FontSize="14"/>

                                        <Label 
                                            Text="{Binding LotSizeDisplay}" 
                                            TextColor="#CCCCCC" 
                                            FontFamily="RobotoSerifRegular" 
                                            FontSize="12"/>
                                    </VerticalStackLayout>

                                    <!-- 2. PRICE GESTURE (Goes to Position Listing) -->
                                    <Label 
                                        Grid.Column="2"
                                        Text="{Binding DisplayPrice}" 
                                        TextColor="White"
                                        FontAttributes="Bold" 
                                        FontSize="18"
                                        VerticalOptions="Center">

                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MarketViewModel}}, Path=NavigateToPositionListingCommand}" 
                                                CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <!-- Difference Badge -->
                                    <Border 
                                        Grid.Column="3" 
                                        HeightRequest="28"
                                        StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 5" 
                                        VerticalOptions="Center"
                                        BackgroundColor="#F44336">

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsPositiveTrend}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#4CAF50" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Label 
                                            Text="{Binding FormattedDifference}" 
                                            TextColor="White" 
                                            FontFamily="RobotoSerifMedium" 
                                            FontSize="12" 
                                            HorizontalOptions="Center" 
                                            VerticalOptions="Center"/>
                                    </Border>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- EMPTY STATE -->
                <VerticalStackLayout 
                    IsVisible="{Binding IsListEmpty}" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Spacing="10">

                    <Image 
                        Source="no_result_icon.png" 
                        HeightRequest="80" 
                        Opacity="0.3"/>

                    <Label 
                        Text="No commodities found" 
                        FontSize="16" 
                        FontFamily="RobotoSerifMedium" 
                        TextColor="White" 
                        HorizontalOptions="Center"/>

                    <Label 
                        Text="Try adjusting your search or commodity type" 
                        FontSize="13" 
                        FontFamily="RobotoSerifRegular" 
                        TextColor="#888888" 
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- 5. IMAGE PREVIEW OVERLAY -->
        <Grid 
            IsVisible="{Binding IsImagePreviewVisible}"
            BackgroundColor="#CC000000"
            ZIndex="100"
            InputTransparent="False">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer 
                    Command="{Binding CloseImagePreviewCommand}"/>
            </Grid.GestureRecognizers>

            <Border 
                StrokeShape="RoundRectangle 20"
                Padding="0"
                StrokeThickness="1"
                Stroke="#333333"
                BackgroundColor="#1E1E1E"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="30">

                <Border.Shadow>
                    <Shadow 
                        Brush="Black" 
                        Offset="0, 10" 
                        Radius="20" 
                        Opacity="0.8" />
                </Border.Shadow>

                <VerticalStackLayout 
                    Spacing="0">

                    <Grid 
                        ColumnDefinitions="*, Auto" 
                        Padding="15, 10">

                        <Label 
                            Text="{Binding SelectedCommodityTypeName}"
                            FontSize="15"
                            FontFamily="RobotoSerifBold"
                            TextColor="White"
                            VerticalOptions="Center"/>

                        <Button 
                            Grid.Column="1"
                            Text="✕"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#444444"
                            CornerRadius="15"
                            HeightRequest="30"
                            WidthRequest="30"
                            Padding="0"
                            Command="{Binding CloseImagePreviewCommand}"/>
                    </Grid>

                    <BoxView 
                        HeightRequest="1" 
                        Color="#333333" />

                    <Image 
                        Source="{Binding PreviewImage}"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" 
                        Margin="20"/>

                    <BoxView 
                        HeightRequest="1" 
                        Color="#333333" />

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>