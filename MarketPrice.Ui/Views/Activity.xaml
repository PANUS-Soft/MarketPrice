<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             x:Class="MarketPrice.Ui.Views.Activity"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Title="Activity">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20,20,20,0">

        <Label Grid.Row="0" 
               Text="Activity"
               FontFamily="RobotoSerifBold"
               FontSize="28"
               TextColor="{StaticResource White}"
               Margin="0,0,0,15"/>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,0,0,15">

            <Border Grid.Column="0" 
                    Stroke="#fff" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 5" 
                    BackgroundColor="{StaticResource OffBlack}" 
                    HeightRequest="40">

                <SearchBar Placeholder="Search" 
                           Text="{Binding SearchText}" 
                           SearchCommand="{Binding ApplyFiltersCommand}" 
                           BackgroundColor="Transparent" 
                           VerticalOptions="Center"/>
            </Border>

            <Border Grid.Column="1" 
                    Stroke="#fff" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 5" 
                    BackgroundColor="{StaticResource OffBlack}" 
                    HeightRequest="40" 
                    WidthRequest="100">

                <Picker ItemsSource="{Binding PositionTypes}" 
                        SelectedItem="{Binding SelectedPositionType}" 
                        TextColor="{StaticResource White}" 
                        Title="All" 
                        HorizontalTextAlignment="Center" 
                        VerticalOptions="Center"/>
            </Border>
        </Grid>

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding CommodityTypes}" 
                        HeightRequest="40" 
                        Margin="0,0,0,15" 
                        SelectionMode="Single" 
                        SelectedItem="{Binding SelectedCommodityType}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#fff" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 5" 
                            BackgroundColor="{StaticResource OffBlack}" 
                            Padding="20,0" 
                            VerticalOptions="Center" 
                            HeightRequest="35">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#fff" />
                                        <Setter TargetName="ChipLabel" Property="Label.TextColor" Value="#000" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Label x:Name="ChipLabel" 
                               Text="{Binding .}" 
                               TextColor="{StaticResource White}" 
                               FontFamily="RobotoSerifBold" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Center"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3">

            <CollectionView ItemsSource="{Binding GroupedActivities}" 
                            IsGrouped="True" 
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">

                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding IsLoading}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </CollectionView.Triggers>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Name}" 
                               FontAttributes="Bold" 
                               FontSize="20" 
                               TextColor="{StaticResource White}" 
                               Margin="0,10,0,10"/>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#fff" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 5" 
                                BackgroundColor="{StaticResource OffBlack}" 
                                Margin="0,0,0,10" 
                                Padding="15">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ActivityViewModel}}, Path=GoToDetailsCommand}" 
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">

                                <Frame Grid.Column="0" 
                                       WidthRequest="70" 
                                       HeightRequest="70" 
                                       CornerRadius="35" 
                                       IsClippedToBounds="True" 
                                       Padding="0" 
                                       VerticalOptions="Center">

                                    <Image Source="{Binding ImageUrl}" 
                                           Aspect="AspectFill" 
                                           BackgroundColor="{StaticResource Gray900}" />
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label TextColor="{StaticResource White}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Commodity Name: " FontFamily="RobotoSerifBold" />
                                                <Span Text="{Binding CommodityName}" FontFamily="RobotoSerifRegular" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label TextColor="{StaticResource White}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Quantity: " FontFamily="RobotoSerifBold" />
                                                <Span Text="{Binding Quantity}" FontFamily="RobotoSerifRegular" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label TextColor="{StaticResource White}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Price: " FontFamily="RobotoSerifBold" />
                                                <Span Text="{Binding Price}" FontFamily="RobotoSerifRegular" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>

                                <Label Grid.Column="2" 
                                       Text="{Binding State}" 
                                       FontFamily="RobotoSerifBold" 
                                       TextColor="{StaticResource White}" 
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <CollectionView ItemsSource="{Binding SkeletonItems}" 
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never">

                <CollectionView.Triggers>
                    <DataTrigger TargetType="CollectionView" Binding="{Binding IsLoading}" Value="False">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </CollectionView.Triggers>

                <CollectionView.Header>
                    <Label Text="Loading Data..." 
                           FontAttributes="Bold" 
                           FontSize="20" 
                           TextColor="{StaticResource Gray400}" 
                           Margin="0,10,0,10"/>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="{StaticResource Gray600}" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 5" 
                                BackgroundColor="{StaticResource OffBlack}" 
                                Margin="0,0,0,10" 
                                Padding="15">

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                <Frame Grid.Column="0" 
                                       WidthRequest="70" 
                                       HeightRequest="70" 
                                       CornerRadius="35" 
                                       BackgroundColor="{StaticResource Gray900}" 
                                       HasShadow="False" 
                                       BorderColor="Transparent" 
                                       Padding="0" 
                                       VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                                    <BoxView HeightRequest="15" WidthRequest="150" Color="{StaticResource Gray900}" CornerRadius="4" HorizontalOptions="Start"/>
                                    <BoxView HeightRequest="15" WidthRequest="100" Color="{StaticResource Gray900}" CornerRadius="4" HorizontalOptions="Start"/>
                                    <BoxView HeightRequest="15" WidthRequest="120" Color="{StaticResource Gray900}" CornerRadius="4" HorizontalOptions="Start"/>
                                </VerticalStackLayout>

                                <BoxView Grid.Column="2" HeightRequest="20" WidthRequest="60" Color="{StaticResource Gray900}" CornerRadius="4" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>