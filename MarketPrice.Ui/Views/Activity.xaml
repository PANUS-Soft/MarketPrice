<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:converters="clr-namespace:MarketPrice.Ui.Converters"
             x:Class="MarketPrice.Ui.Views.Activity"
             Title="Activity">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <StackLayout>

        <StackLayout IsVisible="{Binding IsUserLoggedIn, Converter={StaticResource InvertedBoolConverter}}"
                     VerticalOptions="Center">

            <Image Source="no_activity.png"
                   HeightRequest="120"/>

            <Label Text="No activity yet. You are here as a guest."
                   FontSize="22"
                   HorizontalOptions="Center"/>

            <Label Text="Login or create an account to track your activity."
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <Grid ColumnDefinitions="*, *" Padding="15" ColumnSpacing="10" BackgroundColor="White">
                <Button Grid.Column="0" FontFamily="RobotoSerifBold" Text="Register" BackgroundColor="{StaticResource PrimaryBase}" TextColor="White" CornerRadius="10" Command="{Binding NavigateToRegisterCommand}"/>
                <Button Grid.Column="1" FontFamily="RobotoSerifBold" Text="Log in" BackgroundColor="White" BorderColor="{StaticResource PrimaryBase}" BorderWidth="3" TextColor="{StaticResource PrimaryBase}" CornerRadius="10" Command="{Binding NavigateToLoginCommand}"/>
            </Grid>
        </StackLayout>


        <Grid IsVisible="{Binding IsUserLoggedIn}"  RowDefinitions="Auto, Auto, *" Padding="0,10,0,0">

            <Label Text="Activity"
               FontFamily="RobotoSerifBold"
               FontSize="28"
               Margin="20,10"
               TextColor="Black"/>

            <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="20,10" VerticalOptions="Center">
                <Label Text="CommodityType"
                   FontFamily="RobotoSerifRegular"
                   FontSize="16"
                   VerticalOptions="Center"
                   TextColor="Black"
                   Margin="0,0,10,0"/>

                <dx:ComboBoxEdit Grid.Column="1"
                             ItemsSource="{Binding CommodityTypes}"
                             SelectedItem="{Binding SelectedType}"
                             PlaceholderText="Select..."
                             BoxMode="Outlined"
                             BorderColor= "{StaticResource PrimaryBase}"
                             VerticalOptions="Center"
                             HorizontalOptions="Fill"
                             IsFilterEnabled="False"/>
            </Grid>

            <dx:TabView Grid.Row="2"
                    VerticalOptions="FillAndExpand"
                    HeaderPanelBackgroundColor="White"
                    SelectedItemIndicatorColor="#3E7BB0"
                    SelectedItemIndicatorHeight="3">

                <dx:TabViewItem HeaderText="Positions">
                    <dx:DXCollectionView ItemsSource="{Binding Position}"
                                     SelectionMode="None">
                        <dx:DXCollectionView.ItemTemplate>
                            <DataTemplate>
                                <dx:DXBorder BorderThickness="1" 
                                         BorderColor="#3E7BB0" 
                                         CornerRadius="8" 
                                         Padding="15" 
                                         Margin="15,10"
                                         BackgroundColor="White">
                                    <VerticalStackLayout Spacing="8">

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="Commodity Name:" FontAttributes="Bold" TextColor="Black"/>
                                            <Label Text="{Binding Name}" TextColor="Black"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="Bids Unit Price (Lot):" FontAttributes="Bold" TextColor="Black"/>
                                            <Label Text="{Binding Price}" TextColor="Black"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="Quantity:" FontAttributes="Bold" TextColor="Black"/>
                                            <Label Text="{Binding Quantity}" TextColor="Black"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="Grade:" FontAttributes="Bold" TextColor="Black"/>
                                            <Label Text="{Binding Grade}" TextColor="Black"/>
                                        </HorizontalStackLayout>

                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                                            <dx:DXButton Grid.Column="0" 
                                                     Content="Edit" 
                                                     BackgroundColor="#00569D"
                                                     TextColor="White"
                                                     CornerRadius="18"
                                                     Command="{Binding BindingContext.EditCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                     CommandParameter="{Binding .}"/>

                                            <dx:DXButton Grid.Column="1" 
                                                     Content="Delete" 
                                                     BackgroundColor="#F0544F"
                                                     TextColor="White"
                                                     CornerRadius="18"
                                                     Command="{Binding BindingContext.DeleteCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                     CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </dx:DXBorder>
                            </DataTemplate>
                        </dx:DXCollectionView.ItemTemplate>
                    </dx:DXCollectionView>
                </dx:TabViewItem>

                <dx:TabViewItem HeaderText="Bids" />
                <dx:TabViewItem HeaderText="Offers" />
            </dx:TabView>
        </Grid>
    </StackLayout>
</ContentPage>