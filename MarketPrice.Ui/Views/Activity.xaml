<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             x:Class="MarketPrice.Ui.Views.Activity"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Title="Activity">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20,20,20,0">

        <Label Grid.Row="0" 
               Text="Activity"
               FontFamily="RobotoSerifBold"
               FontSize="28"
               TextColor="Black"
               Margin="0,0,0,15"/>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,0,0,15">
            <Border Grid.Column="0" Stroke="#00569D" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White" HeightRequest="40">
                <SearchBar Placeholder="Search" 
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding ApplyFiltersCommand}"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"/>
            </Border>

            <Border Grid.Column="1" Stroke="#00569D" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White" HeightRequest="40" WidthRequest="100">
                <Picker ItemsSource="{Binding PositionTypes}" 
                        SelectedItem="{Binding SelectedPositionType}"
                        TextColor="Black"
                        Title="All"
                        HorizontalTextAlignment="Center"
                        VerticalOptions="Center"/>
            </Border>
        </Grid>

        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding CommodityTypes}" 
                        HeightRequest="40" 
                        Margin="0,0,0,15"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCommodityType}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#00569D" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White" Padding="20,0" VerticalOptions="Center" HeightRequest="35">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#00569D" />
                                        <Setter TargetName="ChipLabel" Property="Label.TextColor" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Label x:Name="ChipLabel" Text="{Binding .}" TextColor="Black" FontFamily="RobotoSerifBold" VerticalOptions="Center" HorizontalOptions="Center"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding GroupedActivities}" 
                        IsGrouped="True" 
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}" 
                           FontAttributes="Bold" 
                           FontSize="20" 
                           TextColor="Black" 
                           Margin="0,10,0,10"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#00569D" StrokeThickness="1" StrokeShape="RoundRectangle 5" BackgroundColor="White" Margin="0,0,0,10" Padding="15">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ActivityViewModel}}, Path=GoToDetailsCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">

                            <Frame Grid.Column="0" WidthRequest="70" HeightRequest="70" CornerRadius="35" IsClippedToBounds="True" Padding="0" VerticalOptions="Center">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" BackgroundColor="#F0F0F0" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label TextColor="Black">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Commodity Name: " FontFamily="RobotoSerifBold" />
                                            <Span Text="{Binding CommodityName}" FontFamily="RobotoSerifRegular" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label TextColor="Black">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Quantity: " FontFamily="RobotoSerifBold" />
                                            <Span Text="{Binding Quantity}" FontFamily="RobotoSerifRegular" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label TextColor="Black">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Price: " FontFamily="RobotoSerifBold" />
                                            <Span Text="{Binding Price}" FontFamily="RobotoSerifRegular" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                            <Label Grid.Column="2" 
                                   Text="{Binding State}" 
                                   FontFamily="RobotoSerifBold" 
                                   TextColor="Black" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>