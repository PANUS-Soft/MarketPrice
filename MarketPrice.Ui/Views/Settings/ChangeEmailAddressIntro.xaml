<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MarketPrice.Ui.Views.ChangeEmailAddressIntro"
             Title="ChangeEmailAddressIntro"
             Background="#13131F"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Padding="20,10,20,20">

            <ImageButton
                Source="white_back_icon.png"
                BackgroundColor="Transparent"
                HeightRequest="22"
                WidthRequest="22"
                HorizontalOptions="Start"
                Command="{Binding GoBackCommand}"/>
        </Grid>

        <!-- CONTENT -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <!-- Illustration -->
            <Image
                Source="change_email_address"
                HeightRequest="250"
                HorizontalOptions="Center"/>

            <!-- Title -->
            <Label
                Text="Change Email Address"
                FontSize="25"
                FontFamily="RobotoSerifSemibold"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center"/>

            <!-- Description -->
            <Label
                Text="Are you sure you want to change your email address ? You will have to verify your new email address."
                FontSize="16"
                FontFamily="RobotoSerifRegular"
                TextColor="#AAAAAA"
                HorizontalTextAlignment="Center"/>

            <!-- Button -->
            <Button
                Text="Change Email Address"
                FontFamily="RobotoSerifMedium"
                HeightRequest="55"
                CornerRadius="18"
                BackgroundColor="{StaticResource PrimaryBase}"
                TextColor="White"
                FontAttributes="Bold"
                Command="{Binding NavigateToNewEmailCommand}"/>

        </VerticalStackLayout>

    </Grid>
</ContentPage>