<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxe="http://schemas.devexpress.com/maui"
             x:Class="MarketPrice.Ui.Views.PlaceBid"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="PlaceBid"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <x:Array x:Key="FakeCommodities" Type="{x:Type x:String}">
            <x:String>CORN</x:String>
            <x:String>COCOA</x:String>
            <x:String>COFFEE</x:String>
        </x:Array>
        <x:Array x:Key="FakeRegions" Type="{x:Type x:String}">
            <x:String>Littoral</x:String>
            <x:String>Centre</x:String>
            <x:String>West</x:String>
        </x:Array>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">

        <VerticalStackLayout Grid.Row="0" 
                             Spacing="0" 
                             BackgroundColor="White">

            <Grid ColumnDefinitions="Auto, *" 
                  Padding="15,10" 
                  ColumnSpacing="15">

                <ImageButton Grid.Column="0" 
                             Source="back" 
                             HeightRequest="15" 
                             WidthRequest="15" 
                             VerticalOptions="Start" 
                             Margin="0,8,0,0"/>

                <VerticalStackLayout Grid.Column="1" 
                                     Spacing="5" 
                                     HorizontalOptions="Start">

                    <Border Stroke="{StaticResource PrimaryBase}" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 5" 
                            Padding="10,0" 
                            HorizontalOptions="Start" 
                            WidthRequest="130" 
                            BackgroundColor="White">

                        <Grid ColumnDefinitions="*, Auto">
                            <Picker Grid.Column="0" 
                                    Title="Select" 
                                    ItemsSource="{StaticResource FakeCommodities}" 
                                    SelectedIndex="0"
                                    TextColor="Black" 
                                    FontAttributes="Bold" 
                                    FontSize="16" 
                                    HorizontalOptions="Fill" 
                                    VerticalOptions="Center"/>

                            <Label Grid.Column="1" 
                                   Text="▼" 
                                   FontSize="10" 
                                   TextColor="Black" 
                                   VerticalOptions="Center" 
                                   Margin="5,0,0,0"/>
                        </Grid>
                    </Border>

                    <FlexLayout Direction="Row" 
                                Wrap="Wrap" 
                                JustifyContent="Start" 
                                AlignItems="Center">

                        <Label Text="Shelf Life: 2days" 
                               FontSize="12" 
                               TextColor="#666666" 
                               Margin="0,0,15,0"/>

                        <Label Text="Lot Size: 25kg" 
                               FontSize="12" 
                               TextColor="#666666"/>
                    </FlexLayout>
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" 
                     Color="{StaticResource PrimaryBase}" 
                     VerticalOptions="End"/>
        </VerticalStackLayout>


        <BoxView Grid.Row="1" 
                 Color="#F5F5F5"/>

        <VerticalStackLayout Grid.Row="1" 
                             Spacing="10" 
                             Padding="20,10,20,0">

            <Label Text="Place a Bid" 
                   FontSize="22" 
                   FontFamily="RobotoSerifBold" 
                   HorizontalOptions="Center" 
                   TextColor="Black"/>

            <Grid ColumnDefinitions="*,*,*" 
                  ColumnSpacing="5">

                <BoxView Grid.Column="0" 
                         HeightRequest="4" 
                         Color="{StaticResource PrimaryBase}" 
                         CornerRadius="2"/>

                <BoxView Grid.Column="1" 
                         HeightRequest="4" 
                         Color="LightGray" 
                         CornerRadius="2"/>

                <BoxView Grid.Column="2" 
                         HeightRequest="4" 
                         Color="LightGray" 
                         CornerRadius="2"/>
            </Grid>

            <Label Text="Step 1 of 3: Commodity Details" 
                   FontFamily="RobotoSerifBold" 
                   TextColor="Black" 
                   FontSize="14" 
                   Margin="0,15,0,5"/>
        </VerticalStackLayout>


        <ScrollView Grid.Row="2" 
                    Padding="20">
            <Grid>

                <VerticalStackLayout x:Name="Step1_Container" 
                                     IsVisible="True" 
                                     Spacing="25">

                    <Border Stroke="{StaticResource PrimaryBase}" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 5" 
                            Padding="15" 
                            BackgroundColor="White">

                        <VerticalStackLayout Spacing="15">

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Commodity" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="Black"/>

                                <dxe:ComboBoxEdit ItemsSource="{StaticResource FakeCommodities}" 
                                                  PlaceholderText="Select Commodity" 
                                                  BorderColor="{StaticResource PrimaryBase}" 
                                                  BoxMode="Outlined" 
                                                  CornerRadius="5" 
                                                  HeightRequest="45" 
                                                  TextColor="Black" 
                                                  IsFilterEnabled="True"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Grade" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="Black"/>

                                <Grid ColumnDefinitions="*,*,*" 
                                      ColumnSpacing="15">

                                    <Button Grid.Column="0" 
                                            Text="A" 
                                            TextColor="White" 
                                            BackgroundColor="{StaticResource PrimaryBase}" 
                                            CornerRadius="5" 
                                            HeightRequest="40" 
                                            Padding="0"/>

                                    <Button Grid.Column="1" 
                                            Text="B" 
                                            TextColor="Black" 
                                            BackgroundColor="White" 
                                            BorderColor="#CCCCCC" 
                                            BorderWidth="1" 
                                            CornerRadius="5" 
                                            HeightRequest="40" 
                                            Padding="0"/>

                                    <Button Grid.Column="2" 
                                            Text="C" 
                                            TextColor="Black" 
                                            BackgroundColor="White" 
                                            BorderColor="#CCCCCC" 
                                            BorderWidth="1" 
                                            CornerRadius="5" 
                                            HeightRequest="40" 
                                            Padding="0"/>
                                </Grid>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*, *" 
                                  ColumnSpacing="15">

                                <VerticalStackLayout Grid.Column="0" 
                                                     Spacing="5">

                                    <Label Text="Quantity" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="Black"/>

                                    <Border Stroke="Transparent" 
                                            StrokeThickness="0" 
                                            HeightRequest="45" 
                                            BackgroundColor="#F5F5F5" 
                                            StrokeShape="RoundRectangle 5">

                                        <dxe:TextEdit Keyboard="Numeric" 
                                                      PlaceholderText="0.00" 
                                                      TextColor="Black" 
                                                      BoxMode="Filled" 
                                                      BackgroundColor="Transparent"/>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" 
                                                     Spacing="5">

                                    <Label Text="Unit" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="Black"/>

                                    <Border Stroke="Transparent" 
                                            StrokeThickness="0" 
                                            HeightRequest="45" 
                                            BackgroundColor="#F5F5F5" 
                                            StrokeShape="RoundRectangle 5">

                                        <dxe:TextEdit PlaceholderText="Kg" 
                                                      TextColor="Black" 
                                                      BoxMode="Filled" 
                                                      BackgroundColor="Transparent"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Description" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="Black"/>

                                <Border Stroke="Transparent" 
                                        StrokeThickness="0" 
                                        HeightRequest="120" 
                                        Padding="5" 
                                        BackgroundColor="#F5F5F5" 
                                        StrokeShape="RoundRectangle 5">

                                    <dxe:MultilineEdit PlaceholderText="Enter details..." 
                                                       TextColor="Black" 
                                                       BoxMode="Filled" 
                                                       BackgroundColor="Transparent"/>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Continue" 
                            BackgroundColor="{StaticResource PrimaryBase}" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="5" 
                            HeightRequest="50" 
                            Margin="0,0,0,20"/>
                </VerticalStackLayout>


                <VerticalStackLayout x:Name="Step2_Container" 
                                     IsVisible="False" 
                                     Spacing="25">

                    <Border Stroke="{StaticResource PrimaryBase}" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 5" 
                            Padding="15" 
                            BackgroundColor="White">

                        <VerticalStackLayout Spacing="15">

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Unit Price" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="Black"/>

                                <Border Stroke="{StaticResource PrimaryBase}" 
                                        StrokeThickness="1" 
                                        StrokeShape="RoundRectangle 5" 
                                        HeightRequest="45" 
                                        Padding="0">

                                    <Grid ColumnDefinitions="Auto, Auto, *">
                                        <Label Grid.Column="0" 
                                               Text="CFA" 
                                               BackgroundColor="#E5E5E5" 
                                               TextColor="Black" 
                                               VerticalTextAlignment="Center" 
                                               HorizontalTextAlignment="Center" 
                                               WidthRequest="60" 
                                               HeightRequest="45"/>

                                        <BoxView Grid.Column="1" 
                                                 WidthRequest="1" 
                                                 Color="Black"/>

                                        <dxe:TextEdit Grid.Column="2" 
                                                      Keyboard="Numeric" 
                                                      PlaceholderText="0.00" 
                                                      TextColor="Black" 
                                                      BoxMode="Filled" 
                                                      BackgroundColor="Transparent"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <Label Text="Time Line" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="Black" 
                                   Margin="0,10,0,0"/>

                            <Grid ColumnDefinitions="*, *" 
                                  ColumnSpacing="15">

                                <VerticalStackLayout Grid.Column="0" 
                                                     Spacing="5">

                                    <Label Text="Start Date" 
                                           FontSize="14" 
                                           TextColor="#666666"/>

                                    <Border Stroke="LightGray" 
                                            StrokeThickness="1" 
                                            StrokeShape="RoundRectangle 5" 
                                            HeightRequest="45">

                                        <DatePicker TextColor="Black" 
                                                    Margin="5,0"/>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" 
                                                     Spacing="5">

                                    <Label Text="End Date" 
                                           FontSize="14" 
                                           TextColor="#666666"/>

                                    <Border Stroke="LightGray" 
                                            StrokeThickness="1" 
                                            StrokeShape="RoundRectangle 5" 
                                            HeightRequest="45">

                                        <DatePicker TextColor="Black" 
                                                    Margin="5,0"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="Total Offer Value: 0 CFA" 
                                   HorizontalOptions="End" 
                                   FontAttributes="Bold" 
                                   TextColor="Black" 
                                   Margin="0,15,0,5"/>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="Auto, *" 
                          ColumnSpacing="20" 
                          Margin="0,10,0,20">

                        <Button Grid.Column="0" 
                                Text="Back" 
                                BackgroundColor="Transparent" 
                                TextColor="{StaticResource PrimaryBase}" 
                                FontAttributes="Bold" 
                                FontSize="16" 
                                WidthRequest="100"/>

                        <Button Grid.Column="1" 
                                Text="Continue" 
                                BackgroundColor="{StaticResource PrimaryBase}" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="16" 
                                CornerRadius="5" 
                                HeightRequest="50"/>
                    </Grid>
                </VerticalStackLayout>


                <VerticalStackLayout x:Name="Step3_Container" 
                                     IsVisible="False" 
                                     Spacing="25">

                    <Border Stroke="{StaticResource PrimaryBase}" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 5" 
                            Padding="15" 
                            BackgroundColor="White">

                        <VerticalStackLayout Spacing="15">

                            <Label Text="Original Location" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="Black"/>

                            <Grid ColumnDefinitions="*, *" 
                                  ColumnSpacing="15">

                                <VerticalStackLayout Grid.Column="0" 
                                                     Spacing="0">

                                    <dxe:ComboBoxEdit ItemsSource="{StaticResource FakeRegions}" 
                                                       PlaceholderText="Region" 
                                                       BorderColor="Gray" 
                                                       BoxMode="Outlined" 
                                                       CornerRadius="5" 
                                                       HeightRequest="45" 
                                                       TextColor="Black"/>
                                </VerticalStackLayout>

                                <Border Grid.Column="1" 
                                        Stroke="Transparent" 
                                        StrokeThickness="0" 
                                        HeightRequest="45" 
                                        BackgroundColor="#F5F5F5" 
                                        StrokeShape="RoundRectangle 5">

                                    <dxe:TextEdit PlaceholderText="Town" 
                                                  TextColor="Black" 
                                                  BoxMode="Filled" 
                                                  BackgroundColor="Transparent"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*, *" 
                                  ColumnSpacing="15">

                                <Border Grid.Column="0" 
                                        Stroke="Transparent" 
                                        StrokeThickness="0" 
                                        HeightRequest="45" 
                                        BackgroundColor="#F5F5F5" 
                                        StrokeShape="RoundRectangle 5">

                                    <dxe:TextEdit PlaceholderText="Quarter" 
                                                  TextColor="Black" 
                                                  BoxMode="Filled" 
                                                  BackgroundColor="Transparent"/>
                                </Border>

                                <Border Grid.Column="1" 
                                        Stroke="Transparent" 
                                        StrokeThickness="0" 
                                        HeightRequest="45" 
                                        BackgroundColor="#F5F5F5" 
                                        StrokeShape="RoundRectangle 5">

                                    <dxe:TextEdit PlaceholderText="Street" 
                                                  TextColor="Black" 
                                                  BoxMode="Filled" 
                                                  BackgroundColor="Transparent"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="Auto, *" 
                          ColumnSpacing="20" 
                          Margin="0,10,0,20">

                        <Button Grid.Column="0" 
                                Text="Back" 
                                BackgroundColor="Transparent" 
                                TextColor="{StaticResource PrimaryBase}" 
                                FontAttributes="Bold" 
                                FontSize="16" 
                                WidthRequest="100"/>

                        <Button Grid.Column="1" 
                                Text="Post Offer" 
                                BackgroundColor="{StaticResource PrimaryBase}" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="16" 
                                CornerRadius="5" 
                                HeightRequest="50"/>
                    </Grid>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>