<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxc="http://schemas.devexpress.com/maui"
             xmlns:dxe="http://schemas.devexpress.com/maui"
             xmlns:viewModel="clr-namespace:MarketPrice.Ui.ViewModels"
             x:Class="MarketPrice.Ui.Views.Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgPage}"
             Title="Login">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="dxe:TextEdit">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="Black" />
            </Style>

            <Style TargetType="dxe:PasswordEdit">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="Black" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
    <Grid>
        <BoxView VerticalOptions="End" HeightRequest="400" Color="{StaticResource Background}"/>
        <VerticalStackLayout Spacing="0" VerticalOptions="Center" Margin="0,0,0,40">
            <Image Source="Smile.png"
                   HeightRequest="130" 
                   Margin="0, 40, 0, 20"/>

            <Label Text="Login"
                   FontSize="38"
                   FontFamily="RobotoSerifBold" 
                   TextColor="{StaticResource Background}"
                   HorizontalOptions="Center" 
                   Margin="0, 0, 0,30"/>

            <dxc:DXBorder BackgroundColor="{StaticResource BgPage}"
                          CornerRadius="40" 
                          Padding="30" 
                          Margin="30,0" 
                          BorderColor="White"
                          BorderThickness="0.5">
                <dxc:DXBorder.Shadow>
                    <Shadow Brush="#121212"
                            Offset="0,10"
                            Radius="20"
                            Opacity="0.8"/>
                </dxc:DXBorder.Shadow>

                <VerticalStackLayout Spacing="20">
                    <Label Text="Welcome back!"
                           FontSize="24"
                           FontFamily="RobotoSerifBold"
                           HorizontalOptions="Center"
                           TextColor="White"
                           Margin="0,0,0,10"/>

                    <dxe:TextEdit
                        LabelText="Email Address"
                        TextColor="{StaticResource TextSecondary}"
                        Keyboard="Email" 
                        CornerRadius="12" 
                        HeightRequest="60" 
                        Text="{Binding LoginInfo.EmailAddress, Mode=TwoWay}"
                        TextFontFamily="RobotoSerifRegular"/>

                    <dxe:PasswordEdit 
                        LabelText="Password"
                        TextColor="{StaticResource TextSecondary}"
                        CornerRadius="12" 
                        HeightRequest="60"
                        Text="{Binding LoginInfo.Password, Mode=TwoWay}"
                        TextFontFamily="RobotoSerifRegular"/>

                    <Label Text="Forgot password?" HorizontalOptions="End" FontFamily="RobotoSerifLight" TextColor="White"/>

                    <dxe:CheckEdit Label="Remember me?"
                                   LabelFontFamily="RobotoSerifMedium"
                                   IsChecked="{Binding LoginInfo.RememberMe, Mode=TwoWay}"
                                   CheckBoxColor="White"
                                   CheckedCheckBoxColor="White"
                                   LabelColor="White"/>

                    <dxc:DXButton Content="Login"
                                  BackgroundColor= "{StaticResource PrimaryBase }"
                                  CornerRadius="35" HeightRequest="55" 
                                  Margin="0,10" PressedScale="0.95" 
                                  Command="{Binding LoginCommand}"
                                  FontFamily="RobotoSerifBold"/>

                    <Label 
                        HorizontalOptions="Center"
                        Margin="0,10">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span 
                                    Text="Don't have an account? " 
                                    TextColor="{StaticResource TextMutedLegacy}" 
                                    FontFamily="RobotoSerifMedium" />
                                <Span 
                                    Text="Register" 
                                    TextColor="{StaticResource PrimaryAccent}" 
                                    FontFamily="RobotoSerifBold">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </dxc:DXBorder>
        </VerticalStackLayout>
    </Grid>
    </ScrollView>
</ContentPage>