<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             x:Class="MarketPrice.Ui.Views.CommodityDetail"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="White">

            <Grid ColumnDefinitions="Auto, *" 
                  Padding="20,15"
                  ColumnSpacing="15">

                <Border Grid.Column="0"
                        HeightRequest="60"
                        WidthRequest="60"
                        StrokeShape="RoundRectangle 30"
                        Stroke="Transparent"
                        BackgroundColor="Black"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">

                    <Label Text="{Binding Initials}"
                           TextColor="White"
                           FontSize="24"
                           FontFamily="RobotoSerifBold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" 
                                     VerticalOptions="Center" 
                                     Spacing="2">

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="{Binding SellerName}" 
                               FontSize="16" 
                               FontFamily="RobotoSerifBold" 
                               TextColor="Black"/>

                        <Image Source="verified_badge.png" 
                               HeightRequest="16" 
                               WidthRequest="16" 
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="{Binding SellerType, StringFormat='{0} |'}" 
                               FontSize="13" 
                               TextColor="Gray"
                               FontFamily="RobotoSerifRegular"/>

                        <Label Text="⭐⭐⭐⭐⭐" 
                               FontSize="10" 
                               TextColor="#F2C94C"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="📍" 
                               FontSize="12"
                               VerticalOptions="Center"/>

                        <Label Text="{Binding SellerLocation}" 
                               FontSize="13" 
                               TextColor="Black"
                               FontFamily="RobotoSerifRegular"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" 
                     Color="{StaticResource PrimaryBase}" 
                     Opacity="0.3"/>
        </VerticalStackLayout>


        <ScrollView Grid.Row="1" 
                    Padding="20">

            <VerticalStackLayout Spacing="20">

                <Border Stroke="{StaticResource PrimaryBase}" 
                        StrokeThickness="1" 
                        StrokeShape="RoundRectangle 5" 
                        Padding="15" 
                        BackgroundColor="White">

                    <VerticalStackLayout Spacing="15">

                        <Label Text="{Binding CommodityName}" 
                               FontSize="16" 
                               FontFamily="RobotoSerifBold" 
                               TextColor="Black"/>

                        <Grid ColumnDefinitions="*, *, *" 
                              ColumnSpacing="10">

                            <Border Grid.Column="0"
                                    Stroke="{StaticResource PrimaryBase}"
                                    StrokeThickness="1"
                                    HeightRequest="90"
                                    WidthRequest="90"
                                    StrokeShape="RoundRectangle 45"
                                    HorizontalOptions="Center">

                                <VerticalStackLayout VerticalOptions="Center" 
                                                     HorizontalOptions="Center"
                                                     Spacing="0">
                                    <Label Text="{Binding Grade}" 
                                           FontSize="18" 
                                           FontFamily="RobotoSerifBold"
                                           TextColor="Black" 
                                           HorizontalOptions="Center"/>
                                    <Label Text="Grade" 
                                           FontSize="11" 
                                           TextColor="Black" 
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    Stroke="{StaticResource PrimaryBase}"
                                    StrokeThickness="1"
                                    HeightRequest="90"
                                    WidthRequest="90"
                                    StrokeShape="RoundRectangle 45"
                                    HorizontalOptions="Center">

                                <VerticalStackLayout VerticalOptions="Center" 
                                                     HorizontalOptions="Center"
                                                     Spacing="0">
                                    <Label Text="{Binding Quantity}" 
                                           FontSize="16" 
                                           FontFamily="RobotoSerifBold"
                                           TextColor="Black" 
                                           HorizontalOptions="Center"/>
                                    <Label Text="Quantity" 
                                           FontSize="11" 
                                           TextColor="Black" 
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2"
                                    Stroke="{StaticResource PrimaryBase}"
                                    StrokeThickness="1"
                                    HeightRequest="90"
                                    WidthRequest="90"
                                    StrokeShape="RoundRectangle 45"
                                    HorizontalOptions="Center">

                                <VerticalStackLayout VerticalOptions="Center" 
                                                     HorizontalOptions="Center"
                                                     Spacing="0">
                                    <Label Text="{Binding Price}" 
                                           FontSize="14" 
                                           FontFamily="RobotoSerifBold"
                                           TextColor="Black" 
                                           HorizontalOptions="Center"/>
                                    <Label Text="CFA/Lot" 
                                           FontSize="11" 
                                           TextColor="Black" 
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" 
                                 Color="{StaticResource PrimaryBase}" 
                                 Opacity="0.3"/>

                        <Grid RowDefinitions="Auto, Auto" 
                              ColumnDefinitions="*, *" 
                              RowSpacing="8">

                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="{Binding Type, StringFormat='Type: {0}'}" 
                                   TextColor="Black"
                                   FontSize="13"/>

                            <Label Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding LotSize, StringFormat='Lot Size: {0}'}" 
                                   TextColor="Black"
                                   FontSize="13"/>

                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="{Binding Code, StringFormat='Code: {0}'}" 
                                   TextColor="Black"
                                   FontSize="13"/>

                            <Label Grid.Row="1" Grid.Column="1" 
                                   Text="{Binding ShelfLife, StringFormat='Shelf Life: {0}'}" 
                                   TextColor="Black"
                                   FontSize="13"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="{StaticResource PrimaryBase}" 
                        StrokeThickness="1" 
                        StrokeShape="RoundRectangle 5" 
                        Padding="15" 
                        BackgroundColor="White">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Delivery &amp; Logistics" 
                               FontSize="16" 
                               FontFamily="RobotoSerifBold" 
                               TextColor="Black"/>

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="🏠" 
                                   FontSize="16" 
                                   VerticalOptions="Center"/>

                            <Label Text="{Binding Origin, StringFormat='Origin: {0}'}" 
                                   TextColor="Black" 
                                   FontFamily="RobotoSerifBold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="Auto, *" 
                              ColumnSpacing="10">
                            <Label Grid.Column="0" 
                                   Text="🚛" 
                                   FontSize="16" 
                                   VerticalOptions="Start"/>

                            <Label Grid.Column="1" 
                                   Text="{Binding Destination, StringFormat='Destination: {0}'}" 
                                   TextColor="Black" 
                                   FontFamily="RobotoSerifBold"
                                   LineBreakMode="WordWrap"/>
                        </Grid>

                        <Grid RowDefinitions="Auto, Auto" 
                              ColumnDefinitions="*, *" 
                              RowSpacing="5" 
                              Margin="0,10,0,0">

                            <Label Grid.Row="0" Grid.Column="0" 
                                   Text="{Binding LeadTime, StringFormat='Lead Time: {0}'}" 
                                   TextColor="Black"
                                   FontSize="13"/>

                            <Label Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding Fees, StringFormat='Fees: {0}'}" 
                                   TextColor="Black"
                                   FontSize="13"/>

                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="{Binding PossibleDelivery, StringFormat='Possible Delivery: {0}'}" 
                                   TextColor="Black"
                                   FontSize="13"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="{StaticResource PrimaryBase}" 
                        StrokeThickness="1" 
                        StrokeShape="RoundRectangle 5" 
                        Padding="15" 
                        BackgroundColor="White">

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Contact Seller" 
                               FontSize="16" 
                               FontFamily="RobotoSerifBold" 
                               TextColor="Black"/>

                        <Grid ColumnDefinitions="*, *" 
                              ColumnSpacing="10">

                            <dxc:SimpleButton Grid.Column="0"
                                              Text="Call Seller"
                                              Command="{Binding CallSellerCommand}"
                                              BackgroundColor="{StaticResource PrimaryBase}"
                                              TextColor="White"
                                              CornerRadius="20"
                                              HeightRequest="45"
                                              Padding="10,0"
                                              FontSize="13"
                                              FontFamily="RobotoSerifBold"/>

                            <dxc:SimpleButton Grid.Column="1"
                                              Text="Chat on WhatsApp"
                                              Command="{Binding ChatWhatsAppCommand}"
                                              BackgroundColor="#25D366"
                                              TextColor="White"
                                              CornerRadius="20"
                                              HeightRequest="45"
                                              Padding="5,0"
                                              FontSize="12"
                                              FontFamily="RobotoSerifBold"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>