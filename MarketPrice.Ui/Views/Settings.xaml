<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
    xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
    xmlns:models="clr-namespace:MarketPrice.Ui.Models"
    xmlns:dx="http://schemas.devexpress.com/maui"
    x:Class="MarketPrice.Ui.Views.Settings"
    BackgroundColor="#13131F"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- TOP HEADER -->
        <Grid
            Padding="20,50,20,20"
            ColumnDefinitions="Auto,*,Auto">

            <!-- Back Button -->
            <ImageButton
                Source="back_icon.png"
                BackgroundColor="Transparent"
                HeightRequest="22"
                WidthRequest="22"
                Command="{Binding GoBackCommand}"/>

            <!-- Center Profile Info -->
            <VerticalStackLayout
                Grid.Column="1"
                HorizontalOptions="Center"
                Spacing="3">

                <Label
                    Text="{Binding FullName}"
                    FontSize="20"
                    FontFamily="RobotoSerifBold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="{Binding PhoneNumber}"
                    FontSize="13"
                    TextColor="#AAAAAA"
                    HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Three Dot Menu -->
            <ImageButton
                Grid.Column="2"
                Source="menu_dots.png"
                BackgroundColor="Transparent"
                HeightRequest="22"
                WidthRequest="22"
                Command="{Binding OpenMenuCommand}"/>
        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20,10">

                <Label
                    Text="SETTINGS"
                    FontSize="12"
                    FontFamily="RobotoSerifBold"
                    TextColor="#777777"
                    Margin="0,0,0,10"/>

                <Border
                    BackgroundColor="#1E1E2E"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,10">

                    <dxcv:DXCollectionView
                        ItemsSource="{Binding SettingsItems}"
                        SelectionMode="Single"
                        ItemSpacing="0"
                        IsScrollBarVisible="False">

                        <dxcv:DXCollectionView.ItemTemplate>

                            <DataTemplate x:DataType="models:SettingsMenuItem">

                                <Grid
                                    ColumnDefinitions="46, *, Auto"
                                    Padding="0,12"
                                    ColumnSpacing="8">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:SettingsViewModel}}, Path=NavigateToItemCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>

                                    <!-- ICON -->
                                    <Border
                                        BackgroundColor="#2A2A3C"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        HeightRequest="40"
                                        WidthRequest="40">

                                        <Image
                                            Source="{Binding IconSource}"
                                            HeightRequest="20"
                                            WidthRequest="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>
                                    </Border>

                                    <!-- TEXT -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="2"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="14"
                                            FontFamily="RobotoSerifMedium"
                                            TextColor="White"/>

                                        <Label
                                            Text="{Binding SubTitle}"
                                            FontSize="11"
                                            TextColor="#AAAAAA"/>
                                    </VerticalStackLayout>

                                    <!-- ARROW -->
                                    <Label
                                        Grid.Column="2"
                                        Text="›"
                                        FontSize="24"
                                        TextColor="#888888"
                                        VerticalOptions="Center"/>
                                </Grid>

                            </DataTemplate>

                        </dxcv:DXCollectionView.ItemTemplate>

                    </dxcv:DXCollectionView>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>