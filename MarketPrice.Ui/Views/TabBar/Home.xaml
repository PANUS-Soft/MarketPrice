<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MarketPrice.Ui.Views.Home"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:viewModels="clr-namespace:MarketPrice.Ui.ViewModels"
             xmlns:models="clr-namespace:MarketPrice.Ui.Models"
             xmlns:converters="clr-namespace:MarketPrice.Ui.Converters"
             x:DataType="viewModels:HomeViewModel"
             BackgroundColor="{StaticResource BgPage}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:NotZeroConverter x:Key="NotZeroConverter"/>
        <converters:TrendColorConverter x:Key="TrendBidColor" IsOffer="False"/>
        <converters:TrendColorConverter x:Key="TrendOfferColor" IsOffer="True"/>
        <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <converters:StringEmptyConverter x:Key="StringEmptyConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="{StaticResource BgPage}">

        <!-- ── ROW 0: HEADER ── -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgHeader}"
              Padding="16,14"
              ColumnDefinitions="44,*,44">

            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource BgChip}"
                    Stroke="Transparent" StrokeThickness="0"
                    WidthRequest="38" HeightRequest="38"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="19"/>
                </Border.StrokeShape>
                <Image Source="marketprice_logo.svg" Aspect="AspectFit" Margin="6"/>
            </Border>

            <Label Grid.Column="1"
                   Text="MarketPrice"
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="17" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"/>

            <Label Grid.Column="2"
                   Text="⋮"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="22"
                   VerticalOptions="Center" HorizontalOptions="End"/>
        </Grid>

        <!-- ── ROW 1: SEARCH BAR (tappable placeholder) ── -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource SearchBg}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                Margin="16,10,16,8"
                HeightRequest="44">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ActivateSearchCommand}"/>
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="32,*,32" Padding="10,0">
                <Label Text="🔍" FontSize="13"
                       TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center"/>
                <Label Grid.Column="1"
                       Text="Search commodities..."
                       TextColor="{StaticResource TextMuted}"
                       FontSize="13" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ActivateSearchCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!-- ── ROW 2: MAIN COMMODITY LIST ── -->
        <dxcv:DXCollectionView
            Grid.Row="2"
            ItemsSource="{Binding Commodities}"
            SelectionMode="None">

            <dxcv:DXCollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CommodityGroupDisplayModel">
                    <VerticalStackLayout Padding="0,0,0,4">

                        <!-- Group label e.g. "BEANS" -->
                        <Label Text="{Binding GroupName}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="10" FontAttributes="Bold"
                               CharacterSpacing="2.5"
                               Margin="16,14,16,6"/>

                        <!-- Outer group card -->
                        <Border Margin="12,0"
                                BackgroundColor="{StaticResource BgCard}"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Padding="0,8,0,10">

                                <!-- Horizontal scroll of commodity cards -->
                                <CollectionView
                                    ItemsSource="{Binding Commodities}"
                                    MinimumHeightRequest="140"
                                    HorizontalScrollBarVisibility="Never"
                                    VerticalScrollBarVisibility="Never">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CommodityDisplayModel">

                                            <!-- Inner commodity card -->
                                            <Border WidthRequest="300"
                                                    Margin="10,4,0,4"
                                                    BackgroundColor="{StaticResource BgCardInner}"
                                                    Stroke="{StaticResource BorderColor}" StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8"/>
                                                </Border.StrokeShape>

                                                <Grid RowDefinitions="Auto,Auto,Auto"
                                                      ColumnDefinitions="*,*,*">

                                                    <!-- ══ ROW 1: HEADERS ══ -->
                                                    <Label Grid.Row="0" Grid.Column="0"
                                                           Text="TYPE"
                                                           TextColor="{StaticResource TextLabel}"
                                                           FontSize="8" FontAttributes="Bold"
                                                           CharacterSpacing="1.2"
                                                           Margin="10,10,0,6"
                                                           VerticalOptions="Center"/>

                                                    <Grid Grid.Row="0" Grid.Column="1"
                                                          ColumnDefinitions="*"
                                                          Margin="4,0,4,0"
                                                          HeightRequest="34">
                                                        <Label Text="BID"
                                                               TextColor="{StaticResource TextLabel}"
                                                               FontSize="8" FontAttributes="Bold"
                                                               CharacterSpacing="1.2"
                                                               VerticalOptions="Center"/>
                                                        <!--<Label Grid.Column="1"
                                                                   Text="{Binding BestBidQuantity, StringFormat='×{0:N0}Buyers'}"
                                                                   TextColor="{StaticResource TextSecondary}"
                                                                   FontSize="8" VerticalOptions="Center"/>-->
                                                    </Grid>

                                                    <Grid Grid.Row="0" Grid.Column="2"
                                                          ColumnDefinitions="*"
                                                          Margin="4,0,10,0"
                                                          HeightRequest="34">
                                                        <Label Text="OFFER"
                                                               TextColor="{StaticResource TextLabel}"
                                                               FontSize="8" FontAttributes="Bold"
                                                               CharacterSpacing="1.2"
                                                               VerticalOptions="Center"/>
                                                        <!--<Label Grid.Column="1"
                                                                   Text="{Binding BestOfferQuantity, StringFormat='×{0:N0}Sellers'}"
                                                                   TextColor="{StaticResource TextSecondary}"
                                                                   FontSize="8" VerticalOptions="Center"/>-->
                                                    </Grid>

                                                    <BoxView Grid.Row="0" Grid.Column="0"
                                                             Grid.ColumnSpan="3"
                                                             HeightRequest="0.5"
                                                             Color="{StaticResource BgChip}"
                                                             VerticalOptions="End"/>

                                                    <!-- ══ ROW 2: MAIN DATA ══ -->

                                                    <!-- TYPE: image + name + lot -->
                                                    <Grid Grid.Row="1" Grid.Column="0"
                                                          ColumnDefinitions="Auto,*"
                                                          Margin="8,10,4,10"
                                                          ColumnSpacing="7">
                                                        <Border Grid.Column="0"
                                                                WidthRequest="36" HeightRequest="36"
                                                                BackgroundColor="{StaticResource BgChip}"
                                                                Stroke="{StaticResource BorderColor}" StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="18"/>
                                                            </Border.StrokeShape>
                                                            <Image Source="{Binding ImageUrl}"
                                                                   Aspect="AspectFill"
                                                                   WidthRequest="36" HeightRequest="36"/>
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1"
                                                                             VerticalOptions="Center"
                                                                             Spacing="3">
                                                            <Label Text="{Binding Name}"
                                                                   TextColor="{StaticResource TextPrimary}"
                                                                   FontSize="10" FontAttributes="Bold"
                                                                   MaxLines="2"
                                                                   LineBreakMode="WordWrap"/>
                                                            <Label Text="{Binding LotSizeDisplay}"
                                                                   TextColor="{StaticResource TextMuted}"
                                                                   FontSize="8"/>
                                                        </VerticalStackLayout>
                                                    </Grid>

                                                    <!-- BID: price box + depth -->
                                                    <VerticalStackLayout
                                                        Grid.Row="1" Grid.Column="1"
                                                        Margin="4,10,4,10"
                                                        Spacing="4"
                                                        VerticalOptions="Start">
                                                        <Border BackgroundColor="{Binding ., Converter={StaticResource BidBgConverter}}"
                                                                Stroke="{Binding ., Converter={StaticResource BidBorderConverter}}"
                                                                StrokeThickness="1" Padding="6,6">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding BestBidDisplay}"
                                                                   TextColor="{Binding ., Converter={StaticResource BidTextConverter}}"
                                                                   FontSize="13" FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"/>
                                                        </Border>
                                                        
                                                        <!-- Buyer count — always visible -->
                                                        <Label Text="{Binding BuyerCountDisplay}"
                                                               TextColor="{StaticResource TextMuted}"
                                                               FontSize="8"
                                                               HorizontalTextAlignment="Center"/>

                                                        <!-- Depth 1 — always visible, "—" when no data -->
                                                        <Label Text="{Binding NextBid1Display}"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               FontSize="10"
                                                               HorizontalTextAlignment="Center"/>

                                                        <!-- Depth 2 — always visible, "—" when no data -->
                                                        <Label Text="{Binding NextBid2Display}"
                                                               TextColor="{StaticResource TextMuted}"
                                                               FontSize="10"
                                                               HorizontalTextAlignment="Center"/>
                                                    </VerticalStackLayout>

                                                    <!-- OFFER: price box + depth -->
                                                    <VerticalStackLayout
                                                        Grid.Row="1" Grid.Column="2"
                                                        Margin="4,10,10,10"
                                                        Spacing="4"
                                                        VerticalOptions="Start">
                                                        <Border BackgroundColor="{Binding ., Converter={StaticResource OfferBgConverter}}"
                                                                Stroke="{Binding ., Converter={StaticResource OfferBorderConverter}}"
                                                                StrokeThickness="1" Padding="6,6">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="6"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding BestOfferDisplay}"
                                                                   TextColor="{Binding ., Converter={StaticResource OfferTextConverter}}"
                                                                   FontSize="13" FontAttributes="Bold"
                                                                   HorizontalTextAlignment="Center"/>
                                                        </Border>
                                                        <!-- Seller count — always visible -->
                                                        <Label Text="{Binding SellerCountDisplay}"
                                                               TextColor="{StaticResource TextMuted}"
                                                               FontSize="8"
                                                               HorizontalTextAlignment="Center"/>
                                                        <!-- Depth 1 — always visible, "—" when no data -->
                                                        <Label Text="{Binding NextOffer1Display}"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               FontSize="10"
                                                               HorizontalTextAlignment="Center"/>
                                                        <!-- Depth 2 — always visible, "—" when no data -->
                                                        <Label Text="{Binding NextOffer2Display}"
                                                               TextColor="{StaticResource TextMuted}"
                                                               FontSize="10"
                                                               HorizontalTextAlignment="Center"/>
                                                    </VerticalStackLayout>

                                                    <!-- ══ ROW 3: LOCATION FOOTER ══ -->
                                                    <BoxView Grid.Row="2" Grid.Column="0"
                                                             Grid.ColumnSpan="3"
                                                             HeightRequest="0.5"
                                                             Color="{StaticResource BgChip}"/>
                                                    <Label Grid.Row="2" Grid.Column="0"
                                                           Text="REGION"
                                                           TextColor="{StaticResource TextMuted}"
                                                           FontSize="7" FontAttributes="Bold"
                                                           CharacterSpacing="1"
                                                           Margin="10,6,0,7"
                                                           VerticalOptions="Center"/>
                                                    <Label Grid.Row="2" Grid.Column="1"
                                                           Text="{Binding BestBidLocation}"
                                                           TextColor="{StaticResource TextSecondary}"
                                                           FontSize="8"
                                                           Margin="4,6,4,7"
                                                           HorizontalOptions="Center"/>
                                                    <Label Grid.Row="2" Grid.Column="2"
                                                           Text="{Binding BestOfferLocation}"
                                                           TextColor="{StaticResource TextSecondary}"
                                                           FontSize="8"
                                                           Margin="4,6,10,7"
                                                           HorizontalOptions="Center"/>
                                                </Grid>
                                            </Border>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <!-- Label Text="← swipe to explore →"
                                       TextColor="{StaticResource BgChip}"
                                       FontSize="8"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,4,0,2"/-->
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="14,6,14,8">

                                    <!-- Item count -->
                                    <Label Grid.Column="0"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="10">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Commodities.Count}"
                                                      TextColor="{StaticResource TextMuted}"
                                                      FontAttributes="Bold"/>
                                                <Span Text=" items in category"
                                                      TextColor="{StaticResource TextMuted}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    
                                    <!-- View All link -->
                                    <Label Grid.Column="1"
                                           Text="View All"
                                           TextColor="{StaticResource TabActive}"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HomeViewModel}}, Path=ViewAllCommand}"
                                                                  CommandParameter="{Binding CommodityTypeId}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                                

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </dxcv:DXCollectionView.ItemTemplate>
        </dxcv:DXCollectionView>

        <!-- ══ SEARCH OVERLAY ══ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              x:Name="SearchOverlay"
              BackgroundColor="{StaticResource BgPage}"
              IsVisible="{Binding IsSearchActive}"
              RowDefinitions="Auto,Auto,*">

            <!-- Overlay Row 0: Search bar + Cancel -->
            <Grid Grid.Row="0"
                  BackgroundColor="{StaticResource BgHeader}"
                  Padding="16,48,12,14"
                  ColumnDefinitions="*,Auto">

                <Border Grid.Column="0"
                        HeightRequest="36"
                        BackgroundColor="{StaticResource BgCard}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1"
                        >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="36,*,36" Padding="8,0">
                        <Label Text="🔍"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="14"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                        <Entry Grid.Column="1"
                               x:Name="SearchEntry"
                               Text="{Binding SearchText}"
                               Placeholder="Search commodities..."
                               PlaceholderColor="{StaticResource TextMuted}"
                               TextColor="{StaticResource TextPrimary}"
                               BackgroundColor="Transparent"
                               FontSize="13"
                               ReturnType="Search"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2"
                               Text="✕"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="13"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               IsVisible="{Binding SearchText, Converter={StaticResource StringNotEmptyConverter}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearSearchCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

                <Label Grid.Column="1"
                       Text="Cancel"
                       TextColor="{StaticResource TabActive}"
                       FontSize="14"
                       Margin="12,0,4,0"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelSearchCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="*">

                <!-- STATE 1: No query typed yet -->
                <VerticalStackLayout 
                         IsVisible="{Binding IsSearchHintVisible}"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Spacing="12"
                         Padding="32,0">
                    <Label Text="🔍" FontSize="48" HorizontalTextAlignment="Center"  HorizontalOptions="Center"/>
                    <Label Text="Search for a commodity"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="15" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                    <Label Text="e.g. Red Beans, Corn, Egusi"
                           TextColor="{StaticResource TextMuted}"
                           FontSize="12" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- STATE 2: Results found — scrollable list -->
                <dxcv:DXCollectionView
                    ItemsSource="{Binding SearchResults}"
                    SelectionMode="None"
                    VerticalOptions="Fill"
                    IsVisible="{Binding HasSearchResults}">

                    <dxcv:DXCollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CommodityDisplayModel">
                            <Border Margin="12,6,12,0"
                            BackgroundColor="{StaticResource BgCardInner}"
                            Stroke="{StaticResource BorderColor}" StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="*,*,*">
                                    
                                    <!-- ROW 1: HEADERS -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="TYPE"
                                           TextColor="{StaticResource TextLabel}"
                                           FontSize="8" FontAttributes="Bold"
                                           CharacterSpacing="1.2"
                                           Margin="10,9,0,5"
                                           VerticalOptions="Center"/>

                                    <Grid Grid.Row="0" Grid.Column="1"
                                          ColumnDefinitions="*,Auto"
                                          Margin="4,9,4,5">
                                        <Label Text="BID"
                                               TextColor="{StaticResource TextLabel}"
                                               FontSize="8" FontAttributes="Bold"
                                               CharacterSpacing="1.2"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding BestBidQuantity, StringFormat='x{0:N0}Buyers'}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="8"/>
                                    </Grid>

                                    <Grid Grid.Row="0" Grid.Column="2"
                                          ColumnDefinitions="*,Auto"
                                          Margin="4,9,10,5">
                                        <Label Text="OFFER"
                                               TextColor="{StaticResource TextLabel}"
                                               FontSize="8" FontAttributes="Bold"
                                               CharacterSpacing="1.2"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding BestOfferQuantity, StringFormat='x{0:N0}Sellers'}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="8"/>
                                    </Grid>

                                    <BoxView Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                             HeightRequest="0.5"
                                             Color="{StaticResource BgChip}"
                                             VerticalOptions="End"/>
                                    
                                    <!-- ROW 2: MAIN DATA -->    
                                    <Grid Grid.Row="1" Grid.Column="0"
                                          ColumnDefinitions="Auto,*"
                                          Margin="8,10,4,10"
                                          ColumnSpacing="7">
                                        <Border Grid.Column="0"
                                                WidthRequest="36" HeightRequest="36"
                                                BackgroundColor="{StaticResource BgChip}"
                                                Stroke="{StaticResource BorderColor}"
                                                StrokeThickness="1"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18"/>
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="36" HeightRequest="36"/>   
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1"
                                                             VerticalOptions="Center"
                                                             Spacing="3">
                                            <Label Text="{Binding Name}"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   FontSize="10" FontAttributes="Bold"
                                                   MaxLines="2"
                                                   LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding LotSizeDisplay}"
                                                   TextColor="{StaticResource TextMuted}"
                                                   FontSize="8"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    
                                    <!-- BID column -->
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                             Margin="4,10,4,10"
                                             Spacing="5"
                                             VerticalOptions="Start">
                                        <Border BackgroundColor="{Binding ., Converter={StaticResource BidBgConverter}}"
                                                Stroke="{Binding ., Converter={StaticResource BidBorderConverter}}"
                                                StrokeThickness="1"
                                                Padding="6,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding BestBidDisplay}"
                                                   TextColor="{Binding ., Converter={StaticResource BidTextConverter}}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center"/>
                                        </Border>
                                        <Label Text="{Binding NextBid1, StringFormat='{0:N0}'}"
                                               TextColor="{StaticResource AccentGreenDim}"
                                               FontSize="10"
                                               IsVisible="{Binding NextBid1, Converter={StaticResource NotZeroConverter}}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding NextBid2, StringFormat='{0:N0}'}"
                                               TextColor="{StaticResource AccentGreenFaint}"
                                               FontSize="10"
                                               IsVisible="{Binding NextBid2, Converter={StaticResource NotZeroConverter}}"
                                               HorizontalTextAlignment="Center"/>       
                                    </VerticalStackLayout>

                                    <!-- OFFER column -->
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="2"
                                                         Margin="4,10,10,10"
                                                         Spacing="5"
                                                         VerticalOptions="Start">
                                        <Border BackgroundColor="{Binding ., Converter={StaticResource OfferBgConverter}}"
                                                Stroke="{Binding ., Converter={StaticResource OfferBorderConverter}}"
                                                StrokeThickness="1"
                                                Padding="6,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding BestOfferDisplay}"
                                                   TextColor="{Binding ., Converter={StaticResource OfferTextConverter}}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center"/>
                                        </Border>
                                        <Label Text="{Binding NextOffer1, StringFormat='{0:N0}'}"
                                               TextColor="{StaticResource AccentRedDim}"
                                               FontSize="10"
                                               IsVisible="{Binding NextOffer1, Converter={StaticResource NotZeroConverter}}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding NextOffer2, StringFormat='{0:N0}'}"
                                               TextColor="{StaticResource AccentRedFaint}"
                                               FontSize="10"
                                               IsVisible="{Binding NextOffer2, Converter={StaticResource NotZeroConverter}}"
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>

                                    <!-- ROW 3: LOCATION FOOTER -->
                                    <BoxView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                             HeightRequest="0.5"
                                             Color="{StaticResource BgChip}"/>
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="REGION"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="7" FontAttributes="Bold"
                                           CharacterSpacing="1"
                                           Margin="10,6,0,7"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="{Binding BestBidLocation}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="8"
                                           Margin="4,6,4,7"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="{Binding BestOfferLocation}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="8"
                                           Margin="4,6,10,7"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </dxcv:DXCollectionView.ItemTemplate>
                </dxcv:DXCollectionView>

                <!-- STATE 3: Query typed but nothing matched -->
                <VerticalStackLayout
                    IsVisible="{Binding IsSearchEmpty}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="16"
                    Padding="32,0">   
                    <Label Text="😕" FontSize="40" HorizontalOptions="Center"/>
                    <Label Text="No commodities found"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="15" HorizontalOptions="Center"/>
                    <Label Text="{Binding SearchText, StringFormat='No results for &quot;{0}&quot;'}"
                           TextColor="{StaticResource TextMuted}"
                           FontSize="12" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- ══ END SEARCH OVERLAY ══ -->

    </Grid>
</ContentPage>