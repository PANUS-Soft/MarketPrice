<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             x:Class="MarketPrice.Ui.Views.EditPosition"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20">

        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
            <ImageButton Source="back.png" Command="{Binding GoBackCommand}" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent"/>
            <Label Text="Edit Position" FontSize="26" FontFamily="RobotoSerifBold" TextColor="Black"/>
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Margin="0,20,0,10" Spacing="8">
            <dx:DXBorder BorderThickness="1" BorderColor="#3E7BB0" CornerRadius="4" Padding="12,4" HorizontalOptions="Start">
                <Label Text="CORN" TextColor="#3E7BB0" FontSize="14" FontFamily="RobotoSerifMedium"/>
            </dx:DXBorder>
            <HorizontalStackLayout Spacing="15">
                <Label Text="Shelf Life: 2days" FontFamily="RobotoSerifRegular" TextColor="Gray" FontSize="13"/>
                <Label Text="Lot Size: 25Kg" FontFamily="RobotoSerifRegular" TextColor="Gray" FontSize="13"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="2" Margin="0,10">
            <VerticalStackLayout Spacing="10">

                <dx:DXBorder BackgroundColor="#F8F8F8" Padding="15" CornerRadius="5">
                    <dx:DXBorder.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDetailsCommand}"/>
                    </dx:DXBorder.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                        <Label Text="Commodity Details" FontSize="16" FontFamily="RobotoSerifMedium" TextColor="Black"/>
                    </HorizontalStackLayout>
                </dx:DXBorder>

                <VerticalStackLayout IsVisible="{Binding IsDetailsExpanded}" Padding="10,5" Spacing="15">
                    <Label Text="Commodity" FontSize="14" FontFamily="RobotoSerifRegular" TextColor="Gray"/>
                    <dx:ComboBoxEdit ItemsSource="{Binding Commodities}" BoxMode="Outlined" IsFilterEnabled="False"/>

                    <Label Text="Grade" TextColor="Black" Margin="0,5,0,0"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <dx:DXButton Grid.Column="0" Content="High" BackgroundColor="White" BorderColor="#CCCCCC" BorderThickness="1" TextColor="Black"/>
                        <dx:DXButton Grid.Column="1" Content="Medium" BackgroundColor="White" BorderColor="#CCCCCC" BorderThickness="1" TextColor="Black"/>
                        <dx:DXButton Grid.Column="2" Content="Low" BackgroundColor="White" BorderColor="#CCCCCC" BorderThickness="1" TextColor="Black"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <dx:TextEdit Grid.Column="0" LabelText="Quantity" BoxMode="Outlined" Text="0"/>
                        <dx:TextEdit Grid.Column="1" LabelText="Total Quantity" BoxMode="Outlined" Text="0"/>
                    </Grid>

                    <dx:MultilineEdit PlaceholderText="Description (Optional)" BoxMode="Outlined" HeightRequest="100"/>
                </VerticalStackLayout>

                <dx:DXBorder BackgroundColor="#F8F8F8" Padding="15" CornerRadius="5">
                    <dx:DXBorder.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePricingCommand}"/>
                    </dx:DXBorder.GestureRecognizers>
                    <Label Text="Pricing and Timing" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                </dx:DXBorder>

                <VerticalStackLayout IsVisible="{Binding IsPricingExpanded}" Padding="10">
                    <Label Text="Pricing Settings..." TextColor="Gray"/>
                </VerticalStackLayout>

                <dx:DXBorder BackgroundColor="#F8F8F8" Padding="15" CornerRadius="5">
                    <dx:DXBorder.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleLogisticCommand}"/>
                    </dx:DXBorder.GestureRecognizers>
                    <Label Text="Logistic" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                </dx:DXBorder>

                <VerticalStackLayout IsVisible="{Binding IsLogisticExpanded}" Padding="10">
                    <Label Text="Logistic Settings..." TextColor="Gray"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <dx:DXButton Grid.Row="3" Content="SAVE" BackgroundColor="#00569D" HeightRequest="50" CornerRadius="5" TextColor="White"/>
    </Grid>
    
</ContentPage>